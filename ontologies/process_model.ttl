        "언젠가"@kr,
        "dag"@nl,
        "doba"@pl,
        "dia"@pt,
        "一天"@zh ;
    time:days 1 ;
    time:hours 0 ;
    time:minutes 0 ;
    time:months 0 ;
    time:seconds 0 ;
    time:weeks 0 ;
    time:years 0 .

