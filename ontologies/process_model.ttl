<http://www.w3.org/2006/time#inTimePosition> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://www.w3.org/2006/time#inTemporalPosition> ;
                                             rdfs:domain <http://www.w3.org/2006/time#Instant> ;
                                             rdfs:range <http://www.w3.org/2006/time#TimePosition> ;
                                             rdfs:comment "Posición de un instante, expresada como una coordenada temporal o un valor nominal."@es ,
