#    Rules
#################################################################

<http://www.w3.org/2006/time#a> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#start> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#b> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#end> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#endA> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#endB> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#endDateA> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#endDateB> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#startA> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#startB> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#startDateA> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#startDateB> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<http://www.w3.org/2006/time#boundary> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "IntervalEquals" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#hasBeginning> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <http://www.w3.org/2006/time#a> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> <http://www.w3.org/2006/time#start>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#hasBeginning> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <http://www.w3.org/2006/time#b> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <http://www.w3.org/2006/time#start>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#hasEnd> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <http://www.w3.org/2006/time#a> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> <http://www.w3.org/2006/time#end>
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#hasEnd> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> <http://www.w3.org/2006/time#b> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> <http://www.w3.org/2006/time#end>
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#intervalEquals> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <http://www.w3.org/2006/time#a> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> <http://www.w3.org/2006/time#b>
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "IntervalStarts_DirectDates" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
