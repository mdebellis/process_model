###  http://www.w3.org/ns/prov-o
<http://www.w3.org/ns/prov-o> rdf:type owl:NamedIndividual .


###  http://www.w3.org/ns/prov-o-20130312
<http://www.w3.org/ns/prov-o-20130312> rdf:type owl:NamedIndividual .


###  http://www.w3.org/ns/prov#EmptyCollection
<http://www.w3.org/ns/prov#EmptyCollection> rdf:type owl:NamedIndividual .


###  https://www.michaeldebellis.com/prov_lite
<https://www.michaeldebellis.com/prov_lite> rdf:type owl:NamedIndividual ;
                                            <http://www.w3.org/ns/prov#specializationOf> <http://www.w3.org/ns/prov-o> ;
                                            <http://www.w3.org/ns/prov#wasRevisionOf> <http://www.w3.org/ns/prov-o-20130312> .


[ xsd:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"
] .

[ xsd:pattern "---(0[1-9]|[1-9][0-9])(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"
 ] .

[ xsd:pattern "--(0[1-9]|1[0-9]|20)(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"
 ] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
   owl:members ( <https://w3id.org/sulo/Capability>
                 <https://w3id.org/sulo/InformationObject>
                 <https://w3id.org/sulo/Quality>
                 <https://w3id.org/sulo/Role>
               )
 ] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/sulo/Duration>
                <https://w3id.org/sulo/TimeInstant>
                <https://w3id.org/sulo/TimeInterval>
              )
] .


