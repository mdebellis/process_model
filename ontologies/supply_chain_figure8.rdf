    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#inTemporalPosition"/>
    <skos:definition xml:lang="en">Position of a time instant expressed as a TimePosition</skos:definition>
    <skos:definition xml:lang="es">Posición de un instante, expresada como una coordenada temporal o un valor nominal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.michaeldebellis.com/process_model/IntervalStarts_DirectDates">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>IntervalStarts_DirectDates</rdfs:label>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdfs:comment xml:lang="en">Allen interval relation: a.start = b.start and a.end &lt; b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
    <swrl:body rdf:nodeID="N78e35467e930434e8149768ab3e363b4"/>
    <swrl:head rdf:nodeID="Nb95bb5aed2374bea91ec89df04d18c4b"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N857f7336b9634dc1a7528a61ffac0537">
