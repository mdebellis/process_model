  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_model/DecisionVariable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Decision variable</rdfs:label>
