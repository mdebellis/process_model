  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_model/ExclusiveChoice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Exclusive choice</rdfs:label>
    <rdfs:comment xml:lang="en">An explicitly modeled choice grouping alternative ConditionalTransitions. The alternatives should share the stated choiceAfterStep and have explicit conditions. Runtime branch selection and completeness checks belong to a controller or human.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/InformationObject"/>
  </rdf:Description>
