  <rdf:Description rdf:about="https://www.in2use.com/process_model/expected_duration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">expected duration</rdfs:label>
    <skos:prefLabel xml:lang="en">expected duration</skos:prefLabel>
    <rdfs:comment xml:lang="en">An estimate of the elapsed duration of an execution described by a Plan or Step, represented as an OWL-Time Duration with a numeric value and unit. It is not actual elapsed time, labor effort, or an implicit working-calendar calculation. State separately whether a composite estimate includes rework. No default inheritance or roll-up arithmetic is implied.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <rdfs:domain rdf:nodeID="N56ad8684772e4c0ebe237d68c8df2753"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Duration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Collection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Collection</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <prov:definition xml:lang="en">A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections.</prov:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/process_model/precedes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">precedes</rdfs:label>
    <skos:prefLabel xml:lang="en">precedes</skos:prefLabel>
    <rdfs:comment xml:lang="en">Inverse of p-plan:isPrecededBy. This is planned precedence, not a timestamp relation between actual Activities. Immediate possible control-flow edges are modeled separately as StepTransitions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <owl:inverseOf rdf:resource="http://purl.org/net/p-plan#isPrecededBy"/>
    <rdfs:domain rdf:resource="http://purl.org/net/p-plan#Step"/>
    <rdfs:range rdf:resource="http://purl.org/net/p-plan#Step"/>
  </rdf:Description>
