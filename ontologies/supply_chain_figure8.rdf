    <skos:definition xml:lang="en">An example of the use of a concept.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_figure8/Run01SendAndAwaitVoteAssociation">
