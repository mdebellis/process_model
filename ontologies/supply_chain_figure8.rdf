  <rdf:Description rdf:about="https://www.in2use.com/method_omega/Approval_To_Requirements_Completion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.in2use.com/process_model/Finish_To_Start_Transition"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/StepTransition"/>
