    <skos:prefLabel xml:lang="ar">شهر واحد</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Monat</skos:prefLabel>
    <skos:prefLabel xml:lang="en">month</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mes</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">mois</skos:prefLabel>
    <skos:prefLabel xml:lang="it">mese</skos:prefLabel>
    <skos:prefLabel xml:lang="jp">一か月</skos:prefLabel>
    <skos:prefLabel xml:lang="kr">한달</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">maand</skos:prefLabel>
