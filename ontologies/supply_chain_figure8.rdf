    <dcterms:title xml:lang="en">Basic Reusable Ontology 1 big_bro</dcterms:title>
    <dcterms:title xml:lang="en">Simplified Upper Level Ontology</dcterms:title>
    <dcterms:title xml:lang="en">The P-Plan ontology</dcterms:title>
    <ns2:authoredBy rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
