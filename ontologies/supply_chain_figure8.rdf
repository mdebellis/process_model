  <rdf:Description rdf:about="https://www.in2use.com/process_model/Finish_To_Start_Transition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Finish To Start Transition</rdfs:label>
    <skos:prefLabel xml:lang="en">Finish To Start Transition</skos:prefLabel>
    <rdfs:comment xml:lang="en">A planned possible transition that, when selected, requires the source Activity occurrence to have completed by the time the target occurrence starts. No overlap is permitted; zero waiting time is permitted. Applies to the particular occurrences connected by that transition, including a later iteration of a loop. This declaration neither executes a transition nor infers actual interval relations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <rdfs:subClassOf rdf:resource="https://www.michaeldebellis.com/supply_chain_model/StepTransition"/>
  </rdf:Description>
