  <rdf:Description rdf:about="http://www.w3.org/2006/time#intervalBefore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">interval before</rdfs:label>
    <rdfs:label xml:lang="es">intervalo anterior</rdfs:label>
    <rdfs:comment xml:lang="en">If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2.</rdfs:comment>
    <rdfs:comment xml:lang="es">Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#before"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#intervalDisjoint"/>
    <skos:definition xml:lang="en">If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2.</skos:definition>
    <skos:definition xml:lang="es">Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_figure8/InitialDraftVar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/DocumentVariable"/>
    <rdfs:label xml:lang="en">Initial tender draft</rdfs:label>
    <pp:isVariableOfPlan rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/TenderingPlan"/>
    <rdfs:comment xml:lang="en">Initial document version produced by the lead supplier; distinct from both partner contributions and the revised tender.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_figure8/SubmissionChoice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/ExclusiveChoice"/>
    <rdfs:label xml:lang="en">Submit or replace partner</rdfs:label>
    <rdfs:comment xml:lang="en">Explicit XOR choice after the lead supplier receives the partner vote. Approval permits submission; rejection permits replacement, as described in the text accompanying Figure 8. An absent decision does not select either branch.</rdfs:comment>
    <sc:choiceAfterStep rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/t11SendTenderForVotingTask"/>
    <sc:hasAlternative rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/ApprovalToSubmission"/>
    <sc:hasAlternative rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/RejectionToReplacement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb0212c93f7334b81addfe2b28a6198bf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment>Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or "quoting", some or all of it. </rdfs:comment>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
    <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasQuotedFrom"/>
    <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/sulo/isItemIn">
