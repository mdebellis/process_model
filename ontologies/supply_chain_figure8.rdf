  <rdf:Description rdf:about="http://www.w3.org/2006/time#inTimePosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Time position</rdfs:label>
    <rdfs:label xml:lang="es">posición de tiempo</rdfs:label>
    <rdfs:comment xml:lang="en">Position of an instant, expressed as a temporal coordinate or nominal value</rdfs:comment>
    <rdfs:comment xml:lang="es">Posición de un instante, expresada como una coordenada temporal o un valor nominal.</rdfs:comment>
