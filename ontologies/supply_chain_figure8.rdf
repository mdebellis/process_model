    <rdfs:label xml:lang="en">Decision result</rdfs:label>
    <rdfs:comment xml:lang="en">An actual decision artifact, linked to its DecisionVariable by correspondsToVariable, its subject document by aboutVersion, and its outcome by hasOutcome.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/net/p-plan#Entity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/InformationObject"/>
  </rdf:Description>
