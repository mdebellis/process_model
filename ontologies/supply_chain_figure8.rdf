    <skos:definition xml:lang="en">A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. </skos:definition>
    <skos:definition xml:lang="es">Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N20cde76fe674419db1c9c5f671070e21">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="Nbf523a8c1ab64fe5938e877e96f9b904"/>
