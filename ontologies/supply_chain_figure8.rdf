  <rdf:Description rdf:about="https://w3id.org/sulo/Collection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collection</rdfs:label>
    <rdfs:comment xml:lang="en">A collection is an information object for which there may be zero or more items.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N9a62d19f01a34fa39100432c9f8f67cb"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/InformationObject"/>
    <owl:disjointWith rdf:resource="https://w3id.org/sulo/Quantity"/>
    <skos:example xml:lang="en">a stamp collection, a murder of crows, the arm of a clinical trial</skos:example>
    <skos:prefLabel xml:lang="en">Collection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An information object that aggregates or organizes other information objects. This class is not intended as a general superclass for social groups, physical aggregates, organizations, or arbitrary mathematical sets. MD 7/15/26</skos:scopeNote>
  </rdf:Description>
