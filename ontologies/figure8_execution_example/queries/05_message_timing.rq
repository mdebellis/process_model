PREFIX fig8: <https://www.michaeldebellis.com/supply_chain_figure8/>
PREFIX sc: <https://www.michaeldebellis.com/supply_chain_model/>
PREFIX pp: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX sulo: <https://w3id.org/sulo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?message ?messageLabel ?sender ?recipient ?producer ?generated ?consumer ?used WHERE {
  fig8:TenderRun01 sulo:hasPart ?producer, ?consumer.
  ?message a sc:Message; rdfs:label ?messageLabel;
    sc:sender ?sender; sc:recipient ?recipient;
    prov:wasGeneratedBy ?producer; prov:generatedAtTime ?generatedValue.
  ?consumer prov:qualifiedUsage ?usage.
  ?usage prov:entity ?message; prov:atTime ?usedValue.
  BIND(xsd:dateTime(STR(?generatedValue)) AS ?generated)
  BIND(xsd:dateTime(STR(?usedValue)) AS ?used)
}
ORDER BY ?generated
