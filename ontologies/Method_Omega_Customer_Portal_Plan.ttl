pm:Portal_Requirements_Approved_Choice a owl:NamedIndividual,
        pm:Exclusive_Choice ;
    rdfs:label "Portal Requirements Approved Choice"@en ;
    rdfs:comment "The project-specific requirements-review branch. Approval permits completion; rejection leads to a new pass through detailed requirements and review. Neither outcome is asserted by this plan."@en ;
    skos:prefLabel "Portal Requirements Approved Choice"@en ;
    prov:wasDerivedFrom pm:Requirements_Approved_Choice ;
    pm:has_alternative pm:Portal_Approval_To_Requirements_Completion,
        pm:Portal_Rejection_To_Requirements_Rework ;
    pm:has_choice_source_step pm:Portal_Review_Requirements .

