pm:Portal_Approval_To_Requirements_Completion a owl:NamedIndividual,
        pm:Conditional_Transition,
        pm:Finish_To_Start_Transition,
        pm:Step_Transition ;
    rdfs:label "Portal Approval To Requirements Completion"@en ;
    skos:prefLabel "Portal Approval To Requirements Completion"@en ;
    prov:wasDerivedFrom pm:Approval_To_Requirements_Completion ;
    pm:has_condition pm:Portal_Requirements_Approved_Condition ;
    pm:has_source_step pm:Portal_Review_Requirements ;
    pm:has_target_step pm:Portal_Requirements_Acquisition_Completed .

pm:Portal_Rejection_To_Requirements_Rework a owl:NamedIndividual,
        pm:Conditional_Transition,
        pm:Finish_To_Start_Transition,
        pm:Step_Transition ;
    rdfs:label "Portal Rejection To Requirements Rework"@en ;
    rdfs:comment "A conditional return to a later requirements-development pass. It does not add a reverse precedence assertion, and the baseline timestamps do not schedule this possible later pass."@en ;
    skos:prefLabel "Portal Rejection To Requirements Rework"@en ;
    prov:wasDerivedFrom pm:Rejection_To_Requirements_Rework ;
    pm:has_condition pm:Portal_Requirements_Not_Approved_Condition ;
    pm:has_source_step pm:Portal_Review_Requirements ;
    pm:has_target_step pm:Portal_Create_Detailed_Requirements .

pm:Portal_Requirements_Approved_Condition a owl:NamedIndividual,
        pm:Decision_Condition ;
    rdfs:label "Portal Requirements Approved Condition"@en ;
    skos:definition "The decision artifact bound to Portal Requirements Review Decision in a future execution of this project and review round has the explicit Approved outcome. The plan does not assert that the condition currently holds; a missing decision is not rejection."@en ;
    skos:prefLabel "Portal Requirements Approved Condition"@en ;
    prov:wasDerivedFrom pm:Requirements_Approved_Condition ;
    pm:has_condition_variable pm:Portal_Requirements_Review_Decision ;
    pm:has_expected_outcome pm:Approved .

pm:Portal_Requirements_Not_Approved_Condition a owl:NamedIndividual,
        pm:Decision_Condition ;
    rdfs:label "Portal Requirements Not Approved Condition"@en ;
    skos:definition "The decision artifact bound to Portal Requirements Review Decision in a future execution of this project and review round has the explicit Rejected outcome. The plan does not assert that the condition currently holds; a missing decision is not rejection."@en ;
    skos:prefLabel "Portal Requirements Not Approved Condition"@en ;
    prov:wasDerivedFrom pm:Requirements_Not_Approved_Condition ;
    pm:has_condition_variable pm:Portal_Requirements_Review_Decision ;
    pm:has_expected_outcome pm:Rejected .


