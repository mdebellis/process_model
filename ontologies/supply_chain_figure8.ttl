                                                                                                    swrl:arguments ( var:startDateB var:startDateA ) ;
                                                                                                    swrl:builtin swrlb:lessThan ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                            swrl:arguments ( var:endDateA var:endDateB ) ;
                                                                                                            swrl:builtin swrlb:equal ] ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ;
