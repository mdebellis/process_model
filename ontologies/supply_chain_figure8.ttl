                                    swrl:argument2 var:startDateA ;
                                    swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 var:endA ;
                                            swrl:argument2 var:endDateA ;
                                            swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( var:startDateA var:endDateA ) ;
                                                    swrl:builtin swrlb:lessThan ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 var:b ;
                                                            swrl:argument2 var:startB ;
                                                            swrl:propertyPredicate time:hasBeginning ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 var:b ;
                                                                    swrl:argument2 var:endB ;
                                                                    swrl:propertyPredicate time:hasEnd ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 var:startB ;
                                                                            swrl:argument2 var:startDateB ;
                                                                            swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                    swrl:argument1 var:endB ;
                                                                                    swrl:argument2 var:endDateB ;
                                                                                    swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                            swrl:arguments ( var:startDateB var:endDateB ) ;
                                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                    swrl:arguments ( var:startDateA var:startDateB ) ;
                                                                                                    swrl:builtin swrlb:equal ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                            swrl:arguments ( var:endDateA var:endDateB ) ;
                                                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate time:intervalStarts ] ;
            rdf:rest () ] .

pm:QualifiedAssociation_Agent a swrl:Imp ;
    rdfs:label "QualifiedAssociation_Agent" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "SWRL equivalent of the standard PROV-O property chain: qualifiedAssociation / agent implies wasAssociatedWith. Retains the lightweight PROV subset and makes qualified agent/role/plan associations usable without adding a PROV property-chain axiom."@en ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:activity ;
                    swrl:argument2 var:association ;
                    swrl:propertyPredicate prov:qualifiedAssociation ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:association ;
                            swrl:argument2 var:agent ;
                            swrl:propertyPredicate prov:agent ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:activity ;
                    swrl:argument2 var:agent ;
                    swrl:propertyPredicate prov:wasAssociatedWith ] ;
            rdf:rest () ] .

<https://www.michaeldebellis.com/prov_lite> a owl:NamedIndividual ;
    prov:specializationOf <http://www.w3.org/ns/prov-o> ;
    prov:wasRevisionOf <http://www.w3.org/ns/prov-o-20130312> .

<https://www.michaeldebellis.com/supply_chain_figure8> a owl:Ontology ;
    rdfs:label "Figure 8: collaborative tendering plan"@en ;
    dcterms:created "2026-10-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-8824-9577> ;
    dcterms:description "Self-contained worked ontology model of Figure 8 in Kazantsev et al. (2024), An ontology-guided approach to process formation and coordination of demand-driven collaborations, International Journal of Production Research 62(9), 3398-3414, DOI 10.1080/00207543.2023.2242508. Represents the planned collaboration, not an observed execution. Includes seven tasks, two start events, three end events, four planned message exchanges and the approval/rejection choice. Contains the corrected reusable base and supply-chain schema without owl:imports."@en ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:source <https://doi.org/10.1080/00207543.2023.2242508>,
        fig8:sourceSchemaMetadata,
        <https://www.michaeldebellis.com/supply_chain_model> ;
    dcterms:title "Collaborative tendering between a lead supplier and an invited partner"@en ;
    owl:versionInfo "figure8-plan-v1-2026-10-22" ;
    skos:changeNote "2026-10-23 - Changed by ChatGPT. Corrected the inherited dcterms:created metadata value from 2025-28-11 to 2025-11-28 (interpreted as 28 November 2025) to address the reported AllegroGraph import error. Workflow definitions and rules are unchanged."@en ;
    skos:changeNote "2026-10-22 — Changed by ChatGPT. Implemented Figure 8 as a separate planned collaboration on the updated supply-chain schema. Added placeholder organizations, contextual role instances, seven task definitions and planned assignments, five planned events, ten control-flow transitions, ten resource/message variables, four message exchanges, and one explicit exclusive choice with approval and rejection conditions. Preserved the figure's seven-task structure by documenting t11 as a send-and-await request/reply task. Retained separate initial-draft, contribution, revised tender and submitted-tender variables, and the single-producer P-Plan semantics. The submitted-tender slot is an explicit completion artifact chosen for this model. Preserved all ten existing SWRL rules. No runtime execution, branch-selection result, synthetic test data or inferred assertions are included."@en ;
    skos:note "Control-flow transitions, message variables and decision conditions are explicit assertions. The existing SWRL rules infer candidate resource dependencies and shared inputs; they neither select a branch nor execute the plan. All declared steps and resource variables are explicitly distinct. Each produced variable has exactly one asserted producer. The call-for-tender variable is supplied externally."@en,
        "Figure 8 returns the partner vote to t11SendTenderForVotingTask. This model interprets that task as sending the voting request and awaiting the reply. Consequently t11 and t12 have resource dependencies in both directions; these describe a request/reply exchange, not a control-flow loop or a reason to assert each task precedes the other. An executable refinement may split sending and receiving into separate steps. The replacement branch ends where the figure ends; no retry loop is added."@en ;
    skos:scopeNote "The paper and Figure 8 specify the task/lane topology and exchanges. Approval leading to submission and rejection leading to replacement are taken from the accompanying text. The figure does not name all message payloads or document slots, so their explicit names and version separation are modeling choices. LeadSupplier and InvitedPartner are placeholder organizations for the example, not identified real companies. No actual executions, messages, votes, tender documents or scenario timestamps are asserted. The inherited historical Time examples remain part of the self-contained base."@en .

fig8:SubmissionChoice a owl:NamedIndividual,
        sc:ExclusiveChoice ;
    rdfs:label "Submit or replace partner"@en ;
    rdfs:comment "Explicit XOR choice after the lead supplier receives the partner vote. Approval permits submission; rejection permits replacement, as described in the text accompanying Figure 8. An absent decision does not select either branch."@en ;
    sc:choiceAfterStep fig8:t11SendTenderForVotingTask ;
    sc:hasAlternative fig8:ApprovalToSubmission,
        fig8:RejectionToReplacement .

fig8:t11SendTenderForVotingTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Send tender for voting and await reply: planned assignment"@en ;
    sc:assignedAgent fig8:LeadSupplier ;
    sc:assignedRole fig8:LeadSupplierRole ;
    sc:assignmentForStep fig8:t11SendTenderForVotingTask .

fig8:t12VoteForTenderTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Vote on tender submission: planned assignment"@en ;
    sc:assignedAgent fig8:InvitedPartner ;
    sc:assignedRole fig8:PartnerRole ;
    sc:assignmentForStep fig8:t12VoteForTenderTask .

fig8:t13ReplaceSupplierTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Replace supplier / invite an alternative partner: planned assignment"@en ;
    sc:assignedAgent fig8:LeadSupplier ;
    sc:assignedRole fig8:LeadSupplierRole ;
    sc:assignmentForStep fig8:t13ReplaceSupplierTask .

fig8:t1CreateTenderDraftTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Create tender draft: planned assignment"@en ;
    sc:assignedAgent fig8:LeadSupplier ;
    sc:assignedRole fig8:LeadSupplierRole ;
    sc:assignmentForStep fig8:t1CreateTenderDraftTask .

fig8:t222MakeInputTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Provide input to the tender: planned assignment"@en ;
    sc:assignedAgent fig8:InvitedPartner ;
    sc:assignedRole fig8:PartnerRole ;
    sc:assignmentForStep fig8:t222MakeInputTask .

fig8:t2IncorporateInputsTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Incorporate partner input: planned assignment"@en ;
    sc:assignedAgent fig8:LeadSupplier ;
    sc:assignedRole fig8:LeadSupplierRole ;
    sc:assignmentForStep fig8:t2IncorporateInputsTask .

fig8:t3SubmitTenderTask_Assignment a owl:NamedIndividual,
        sc:PlannedAssignment ;
    rdfs:label "Submit tender: planned assignment"@en ;
    sc:assignedAgent fig8:LeadSupplier ;
    sc:assignedRole fig8:LeadSupplierRole ;
    sc:assignmentForStep fig8:t3SubmitTenderTask .

sc:SamePlan_FlowDependency a swrl:Imp ;
    rdfs:label "SamePlan_FlowDependency" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Infers a candidate producer-to-consumer dependency when explicitly distinct collaboration steps in the same plan share an output/input variable. No branch or execution-order inference is made."@en ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 scvar:producer ;
                    swrl:classPredicate sc:CollaborationStep ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 scvar:consumer ;
                            swrl:classPredicate sc:CollaborationStep ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 scvar:producer ;
                                    swrl:argument2 scvar:resource ;
                                    swrl:propertyPredicate pplan:hasOutputVar ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 scvar:consumer ;
                                            swrl:argument2 scvar:resource ;
                                            swrl:propertyPredicate pplan:hasInputVar ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 scvar:producer ;
                                                    swrl:argument2 scvar:plan ;
                                                    swrl:propertyPredicate pplan:isStepOfPlan ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 scvar:consumer ;
                                                            swrl:argument2 scvar:plan ;
                                                            swrl:propertyPredicate pplan:isStepOfPlan ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:DifferentIndividualsAtom ;
                                                                    swrl:argument1 scvar:producer ;
                                                                    swrl:argument2 scvar:consumer ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 scvar:producer ;
                    swrl:argument2 scvar:consumer ;
                    swrl:propertyPredicate sc:hasFlowDependency ] ;
            rdf:rest () ] .

sc:SamePlan_SharedInput a swrl:Imp ;
    rdfs:label "SamePlan_SharedInput" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Infers shared planned input between explicitly distinct collaboration steps in the same plan. Shared input does not by itself imply contention or an exclusive choice."@en ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 scvar:producer ;
                    swrl:classPredicate sc:CollaborationStep ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 scvar:consumer ;
                            swrl:classPredicate sc:CollaborationStep ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 scvar:producer ;
                                    swrl:argument2 scvar:resource ;
                                    swrl:propertyPredicate pplan:hasInputVar ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 scvar:consumer ;
                                            swrl:argument2 scvar:resource ;
                                            swrl:propertyPredicate pplan:hasInputVar ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 scvar:producer ;
                                                    swrl:argument2 scvar:plan ;
                                                    swrl:propertyPredicate pplan:isStepOfPlan ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 scvar:consumer ;
                                                            swrl:argument2 scvar:plan ;
                                                            swrl:propertyPredicate pplan:isStepOfPlan ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:DifferentIndividualsAtom ;
                                                                    swrl:argument1 scvar:producer ;
                                                                    swrl:argument2 scvar:consumer ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 scvar:producer ;
                    swrl:argument2 scvar:consumer ;
                    swrl:propertyPredicate sc:sharesInputVariable ] ;
            rdf:rest () ] .

sc:StepExecution a owl:Class ;
    rdfs:label "Step execution"@en ;
    rdfs:comment "An actual performance of a planned step. Through PROV Activity it is a SULO Process. Use qualifiedAssociation for agents and roles, used/wasGeneratedBy for artifacts, and OWL-Time endpoint paths for dated intervals."@en ;
    rdfs:subClassOf pplan:Activity .

sc:aboutVersion a owl:ObjectProperty ;
    rdfs:label "about version"@en ;
    rdfs:comment "Identifies the document version reviewed or voted on; approval of one version does not automatically approve later revisions."@en ;
    rdfs:domain sc:DecisionResult ;
    rdfs:range sc:DocumentVersion .

sc:assignedAgent a owl:ObjectProperty ;
    rdfs:label "assigned agent"@en ;
    rdfs:comment "The agent intended to perform the planned step in this assignment."@en ;
    rdfs:domain sc:PlannedAssignment ;
    rdfs:range prov:Agent .

sc:assignedRole a owl:ObjectProperty ;
    rdfs:label "assigned role"@en ;
    rdfs:comment "The contextual role intended for the assigned agent."@en ;
    rdfs:domain sc:PlannedAssignment ;
    rdfs:range sc:CollaborationRole .

sc:assignmentForStep a owl:ObjectProperty ;
    rdfs:label "assignment for step"@en ;
    rdfs:comment "Identifies the planned step to which this intended assignment applies."@en ;
    rdfs:domain sc:PlannedAssignment ;
    rdfs:range sc:CollaborationStep .

sc:choiceAfterStep a owl:ObjectProperty ;
    rdfs:label "choice after step"@en ;
    rdfs:comment "The planned source step after which the choice is considered. Alternative transitionFrom values should identify this step."@en ;
    rdfs:domain sc:ExclusiveChoice ;
    rdfs:range sc:CollaborationStep .

sc:conditionVariable a owl:ObjectProperty ;
    rdfs:label "condition variable"@en ;
    rdfs:comment "The planned decision-result variable whose realized outcome is to be checked."@en ;
    rdfs:domain sc:DecisionCondition ;
    rdfs:range sc:DecisionVariable .

sc:eventForRole a owl:ObjectProperty ;
    rdfs:label "event for role"@en ;
    rdfs:comment "Identifies the contextual participant role whose workflow lane contains this planned event. It is not an assertion that an agent performed an event."@en ;
    rdfs:domain sc:EventStep ;
    rdfs:range sc:CollaborationRole .

sc:expectedOutcome a owl:ObjectProperty ;
    rdfs:label "expected outcome"@en ;
    rdfs:comment "The outcome value required by the recorded decision condition."@en ;
    rdfs:domain sc:DecisionCondition ;
    rdfs:range sc:DecisionOutcome .

sc:hasAlternative a owl:ObjectProperty ;
    rdfs:label "has alternative"@en ;
    rdfs:comment "A candidate alternative in an explicit exclusive choice; no branch is executed by this assertion."@en ;
    rdfs:domain sc:ExclusiveChoice ;
    rdfs:range sc:ConditionalTransition .

sc:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en ;
    rdfs:comment "The declarative decision condition governing this possible transition."@en ;
    rdfs:domain sc:ConditionalTransition ;
    rdfs:range sc:DecisionCondition .

sc:hasOutcome a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    rdfs:comment "The single outcome of this decision artifact. Different votes or rounds are separate DecisionResult individuals."@en ;
    rdfs:domain sc:DecisionResult ;
    rdfs:range sc:DecisionOutcome .

sc:messagePayloadVariable a owl:ObjectProperty ;
    rdfs:label "message payload variable"@en ;
    rdfs:comment "The planned resource variable carried by this planned message."@en ;
    rdfs:domain sc:MessageVariable ;
    rdfs:range pplan:Variable .

sc:payload a owl:ObjectProperty ;
    rdfs:label "payload"@en ;
    rdfs:comment "An actual artifact carried by this message, such as a document version, contribution or decision result."@en ;
    rdfs:domain sc:Message ;
    rdfs:range prov:Entity .

sc:plannedReceiverRole a owl:ObjectProperty ;
    rdfs:label "planned receiver role"@en ;
    rdfs:comment "The contextual recipient role for this planned message."@en ;
    rdfs:domain sc:MessageVariable ;
    rdfs:range sc:CollaborationRole .

sc:plannedSenderRole a owl:ObjectProperty ;
    rdfs:label "planned sender role"@en ;
    rdfs:comment "The contextual sender role for this planned message."@en ;
    rdfs:domain sc:MessageVariable ;
    rdfs:range sc:CollaborationRole .

sc:previousVersion a owl:ObjectProperty ;
    rdfs:label "previous version"@en ;
    rdfs:comment "Links a newer version to a version it revises; multiple source versions are allowed. Reuses PROV revision provenance without identifying the artifacts."@en ;
    rdfs:domain sc:DocumentVersion ;
    rdfs:range sc:DocumentVersion ;
    rdfs:subPropertyOf prov:wasRevisionOf .

sc:recipient a owl:ObjectProperty ;
    rdfs:label "recipient"@en ;
    rdfs:comment "Recipient of an actual message artifact."@en ;
    rdfs:domain sc:Message ;
    rdfs:range prov:Agent .

sc:sender a owl:ObjectProperty ;
    rdfs:label "sender"@en ;
    rdfs:comment "Sender of an actual message artifact."@en ;
    rdfs:domain sc:Message ;
    rdfs:range prov:Agent .

sc:transitionFrom a owl:ObjectProperty ;
    rdfs:label "transition from"@en ;
    rdfs:comment "Source step of a modeled possible transition."@en ;
    rdfs:domain sc:StepTransition ;
    rdfs:range sc:CollaborationStep .

sc:transitionTo a owl:ObjectProperty ;
    rdfs:label "transition to"@en ;
    rdfs:comment "Target step of a modeled possible transition."@en ;
    rdfs:domain sc:StepTransition ;
    rdfs:range sc:CollaborationStep .

sc:triggeredByVariable a owl:ObjectProperty ;
    rdfs:label "triggered by variable"@en ;
    rdfs:comment "The planned information or message whose availability triggers a planned start event. The start event is not a producer of the variable."@en ;
    rdfs:domain sc:StartEventStep ;
    rdfs:range pplan:Variable .

sc:versionIdentifier a owl:DatatypeProperty ;
    rdfs:label "version identifier"@en ;
    rdfs:comment "A human-readable version identifier. The RDF IRI supplies the artifact identity."@en ;
    rdfs:domain sc:DocumentVersion ;
    rdfs:range xsd:string .

sc:versionOf a owl:ObjectProperty ;
    rdfs:label "version of"@en ;
    rdfs:comment "Groups this particular document version into its continuing document series."@en ;
    rdfs:domain sc:DocumentVersion ;
    rdfs:range sc:DocumentSeries .

dcterms:contributor a owl:AnnotationProperty .

pplan:hasOutputVar a owl:ObjectProperty ;
    rdfs:label "hasOutputVar"@en ;
    rdfs:domain pplan:Step ;
    rdfs:isDefinedBy pplan: ;
    rdfs:range pplan:Variable ;
    owl:inverseOf pplan:isOutputVarOf ;
    prov:definition "p-plan:hasOutputVar binds a p-plan:Step to the p-plan:Variable that will be produced as output in the planned execution"@en .

pplan:isInputVarOf a owl:ObjectProperty ;
    rdfs:label "isInputVarOf"@en ;
    rdfs:domain pplan:Variable ;
    rdfs:isDefinedBy pplan: ;
    rdfs:range pplan:Step ;
    prov:definition "p-plan:isInputVarOf links an input variable of a step to the step."@en .

pplan:isOutputVarOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "isOutputVarOf"@en ;
    rdfs:domain pplan:Variable ;
    rdfs:isDefinedBy pplan: ;
    rdfs:range pplan:Step ;
    prov:definition "p-plan:isOutputVarOf is intended to link an output variable of a step to the step."@en .

rdfs:comment a owl:AnnotationProperty ;
    rdfs:comment ""@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

xsd:date a rdfs:Datatype .

xsd:duration a rdfs:Datatype .

xsd:gDay a rdfs:Datatype .

xsd:gMonth a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

time:April_12_1861 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1861-04-12T00:00:00Z"^^xsd:dateTimeStamp .

time:August_7_1945 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1945-08-07T00:00:00Z"^^xsd:dateTimeStamp .

time:DurationDescription a owl:Class ;
    rdfs:label "Duration description"@en,
        "descripción de duración"@es ;
    rdfs:comment "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ;
            owl:onProperty time:hasTRS ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:days ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:hours ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:minutes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:seconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:weeks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:years ],
        time:GeneralDurationDescription ;
    skos:definition "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ;
    skos:note "In the Gregorian calendar the length of the month is not fixed. Therefore, a value like \"2.5 months\" cannot be exactly compared with a similar duration expressed in terms of weeks or days."@en,
        "En el calendario gregoriano la longitud de los meses no es fija. Por lo tanto, un valor como \"2,5 meses\" no se puede comparar exactamente con una duración similar expresada en términos de semanas o días."@es .

time:July_1_1863 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1863-07-01T00:00:00Z"^^xsd:dateTimeStamp .

time:July_3_1863 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1863-07-03T00:00:00Z"^^xsd:dateTimeStamp .

time:July_4_1946 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1946-07-04T00:00:00Z"^^xsd:dateTimeStamp .

time:June_25_1940 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1940-06-25T00:00:00Z"^^xsd:dateTimeStamp .

time:May_26_1865 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1865-05-26T00:00:00Z"^^xsd:dateTimeStamp .

time:MonthOfYear a owl:Class ;
    rdfs:label "Month of year"@en,
        "mes del año"@es ;
    rdfs:comment "The month of the year"@en,
        "El mes del año."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue time:unitMonth ;
            owl:onProperty time:unitType ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:day ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hour ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:minute ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:month ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:second ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:week ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:year ],
        time:DateTimeDescription ;
    skos:definition "The month of the year"@en,
        "El mes del año."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica en riesgo - añadida en la revisión de 2017, y no utilizada todavía de forma amplia."@es ;
    skos:note "Membership of the class :MonthOfYear is open, to allow for alternative annual calendars and different month names."@en,
        "La pertenencia a la clase 'mes del año' está abierta, a permitir calendarios anuales alternativos y diferentes nombres de meses."@es .

time:October_6_1939 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1939-10-06T00:00:00Z"^^xsd:dateTimeStamp .

time:September_2_1945 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1945-09-02T00:00:00Z"^^xsd:dateTimeStamp .

time:TRS a owl:Class ;
    rdfs:label "Temporal Reference System"@en,
        "sistema de referencia temporal"@es ;
    rdfs:comment """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en,
        """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
        Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
    skos:definition """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en,
        """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
    Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
    skos:note "A taxonomy of temporal reference systems is provided in ISO 19108:2002 [ISO19108], including (a) calendar + clock systems; (b) temporal coordinate systems (i.e. numeric offset from an epoch); (c) temporal ordinal reference systems (i.e. ordered sequence of named intervals, not necessarily of equal duration)."@en,
        "En el ISO 19108:2002 [ISO19108] se proporciona una taxonomía de sistemas de referencia temporal, incluyendo (a) sistemas de calendario + reloj; (b) sistemas de coordenadas temporales (es decir, desplazamiento numérico a partir de una época); (c) sistemas de referencia ordinales temporales (es decir, secuencia ordenada de intervalos nombrados, no necesariamente de igual duración)."@es .

time:TimeZone a owl:Class ;
    rdfs:label "Time Zone"@en,
        "huso horario"@es ;
    rdfs:comment """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en,
        """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
        Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
        La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
    skos:definition """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en,
        """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
    Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
    La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
    skos:historyNote """esIn the original 2006 version of OWL-Time, the TimeZone class, with several properties corresponding to a specific model of time-zones, was defined in a separate namespace "http://www.w3.org/2006/timezone#". 

In the current version a class with same local name is put into the main OWL-Time namespace, removing the dependency on the external namespace. 

An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """,
        """En la versión original de OWL-Time de 2006, se definió, en un espacio de nombres diferente "http://www.w3.org/2006/timezone#", la clase 'huso horario', con varias propiedades específicas correspondientes a un modelo específico de huso horario.
    En la versión actual hay una clase con el mismo nombre local en el espacio de nombres de OWL-Time, eliminando la dependencia del espacio de nombres externo.
    Un axioma de alineación permite que los datos codificados de acuerdo con la versión anterior sean consistentes con la ontología actualizada."""@es ;
    skos:note """A designated timezone is associated with a geographic region. However, for a particular region the offset from UTC often varies seasonally, and the dates of the changes may vary from year to year. The timezone designation usually changes for the different seasons (e.g. Australian Eastern Standard Time vs. Australian Eastern Daylight Time). Furthermore, the offset for a timezone may change over longer timescales, though its designation might not.  

Detailed guidance about working with time zones is given in http://www.w3.org/TR/timezone/ ."""@en,
        "An ontology for time zone descriptions was described in [owl-time-20060927] and provided as RDF in a separate namespace tzont:. However, that ontology was incomplete in scope, and the example datasets were selective. Furthermore, since the use of a class from an external ontology as the range of an ObjectProperty in OWL-Time creates a dependency, reference to the time zone class has been replaced with the 'stub' class in the normative part of this version of OWL-Time."@en,
        """Un huso horario designado está asociado con una región geográfica. Sin embargo, para una región particular el desplazamiento desde UTC a menudo varía según las estaciones, y las fechas de los cambios pueden variar de un año a otro. La designación de huso horario  normalmente cambia de una estación a otra (por ejemplo, el horario estándar frente al horario de verano ambos del este de Australia). Además, del desplazamiento para un huso horario puede cambiar sobre escalas de tiempo mayores, aunque su designación no lo haga.
    Se puede encontrar una guía detallada sobre el funcionamiento de husos horarios en http://www.w3.org/TR/timezone/."@es , "En [owl-time-20060927] se describió una ontología para descripciones de husos horarios, y se proporcionó en un espacio de nombres separado tzont:. Sin embargo, dicha ontología estaba incompleta en su alcance, y el ejemplo de conjuntos de datos (datasets) era selectivo. Además, puesto que el uso de una clase de una ontología externa como el rango de una propiedad de objeto en OWL-Time crea una dependencia, la referencia a la clase huso horario se ha reemplazado por una clase que viene a ser un "cajón de sastre" en la en la parte normativa de esta versión de OWL-Time."""@es ;
    skos:scopeNote "esIn this implementation TimeZone has no properties defined. It should be thought of as an 'abstract' superclass of all specific timezone implementations.",
        "En esta implementación 'huso horario' no tiene definidas propiedades. Se debería pensar como una superclase \"abstracta\" de todas las implementaciones de huso horario específicas."@es .

time:after a owl:ObjectProperty ;
    rdfs:label "after"@en,
        "después"@es ;
    rdfs:comment "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalEntity ;
    owl:inverseOf time:before ;
    skos:definition "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es .

time:dayOfWeek a owl:ObjectProperty ;
    rdfs:label "day of week"@en,
        "día de la semana"@es ;
    rdfs:comment "enEl día de la semana, cuyo valor es un miembro de la clase 'día de la semana'.",
        "The day of week, whose value is a member of the class time:DayOfWeek"@en ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:DayOfWeek ;
    skos:definition "The day of week, whose value is a member of the class time:DayOfWeek"@en,
        "El día de la semana, cuyo valor es un miembro de la clase 'día de la semana'."@es .

time:dayOfYear a owl:DatatypeProperty ;
    rdfs:label "day of year"@en,
        "día del año"@es ;
    rdfs:comment "The number of the day within the year"@en,
        "El número de día en el año."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The number of the day within the year"@en,
        "El número de día en el año."@es .

time:intervalContains a owl:ObjectProperty ;
    rdfs:label "interval contains"@en,
        "intervalo contiene"@es ;
    rdfs:comment "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en,
        "Si un intervalo propio T1 contiene otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 está después del final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    owl:inverseOf time:intervalDuring ;
    skos:definition "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en,
        "Si un intervalo propio T1 contiene otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 está después del final de T2."@es .

time:intervalDuring a owl:ObjectProperty ;
    rdfs:label "interval during"@en,
        "intervalo durante"@es ;
    rdfs:comment "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es .

time:intervalEquals a owl:ObjectProperty ;
    rdfs:label "interval equals"@en,
        "intervalo igual"@es ;
    rdfs:comment "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es igual a otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 coincide con el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    owl:propertyDisjointWith time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es igual a otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalMeets a owl:ObjectProperty ;
    rdfs:label "interval meets"@en,
        "intervalo se encuentra"@es ;
    rdfs:comment "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en,
        "Si un intervalo propio T1 se encuentra con otro intervalo propio T2, entonces el final de T1 coincide con el principio de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    owl:inverseOf time:intervalMetBy ;
    skos:definition "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en,
        "Si un intervalo propio T1 se encuentra con otro intervalo propio T2, entonces el final de T1 coincide con el principio de T2."@es .

time:intervalMetBy a owl:ObjectProperty ;
    rdfs:label "interval met by"@en,
        "intervalo encontrado por"@es ;
    rdfs:comment "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    skos:definition "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es .

time:monthOfYear a owl:ObjectProperty ;
    rdfs:label "month of year"@en,
        "mes del año"@es ;
    rdfs:comment "The month of the year, whose value is a member of the class time:MonthOfYear"@en,
        "El mes del año, cuyo valor es un miembro de la clase 'mes del año'."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:MonthOfYear ;
    skos:definition "The month of the year, whose value is a member of the class time:MonthOfYear"@en,
        "El mes del año, cuyo valor es un miembro de la clase 'mes del año'."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica arriesgada - añadida en la revisión de 2017, y todavía no ampliamente utilizada."@es .

time:nominalPosition a owl:DatatypeProperty ;
    rdfs:label "Name of temporal position"@en,
        "nombre de posición temporal"@es ;
    rdfs:comment "The (nominal) value indicating temporal position in an ordinal reference system "@en,
        "El valor (nominal) que indica posición temporal en un sistema de referencia ordinal."@es ;
    rdfs:domain time:TimePosition ;
    rdfs:range xsd:string ;
    skos:definition "The (nominal) value indicating temporal position in an ordinal reference system "@en,
        "El valor (nominal) que indica posición temporal en un sistema de referencia ordinal."@es .

time:numericDuration a owl:DatatypeProperty ;
    rdfs:label "Numeric value of temporal duration"@en,
        "valor numérico de duración temporal"@es ;
    rdfs:comment "Value of a temporal extent expressed as a decimal number scaled by a temporal unit"@en,
        "Valor de una extensión temporal expresada como un número decimal escalado por una unidad de tiempo."@es ;
    rdfs:domain time:Duration ;
    rdfs:range xsd:decimal ;
    skos:definition "Value of a temporal extent expressed as a decimal number scaled by a temporal unit"@en,
        "Valor de una extensión temporal expresada como un número decimal escalado por una unidad de tiempo."@es .

time:numericPosition a owl:DatatypeProperty ;
    rdfs:label "Numeric value of temporal position"@en,
        "valor numérico de posición temporal"@es ;
    rdfs:comment "The (numeric) value indicating position within a temporal coordinate system "@en,
        "El valor (numérico) que indica posición temporal en un sistema de referencia ordinal."@es ;
    rdfs:domain time:TimePosition ;
    rdfs:range xsd:decimal ;
    skos:definition "The (numeric) value indicating position within a temporal coordinate system "@en,
        "El valor (numérico) que indica posición temporal en un sistema de referencia ordinal."@es .

time:timeZone a owl:ObjectProperty ;
    rdfs:label "in time zone"@en,
        "en huso horario"@es ;
    rdfs:comment "The time zone for clock elements in the temporal position"@en ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:TimeZone ;
    skos:historyNote """esIn the original 2006 version of OWL-Time, the range of time:timeZone was a TimeZone class in a separate namespace "http://www.w3.org/2006/timezone#". 
An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """,
        """En la versión original de OWL-Time de 2006, el rango de 'en huso horario' se definió en un espacio de nombres diferente "http://www.w3.org/2006/timezone#".
            Un axioma de alineación permite que los datos codificados de acuerdo con la versión anterior sean consistentes con la ontología actualizada."""@es ;
    skos:note """esIANA maintains a database of timezones. These are well maintained and generally considered authoritative, but individual items are not available at individual URIs, so cannot be used directly in data expressed using OWL-Time.

DBPedia provides a set of resources corresponding to the IANA timezones, with a URI for each (e.g. http://dbpedia.org/resource/Australia/Eucla). The World Clock service also provides a list of time zones with the description of each available as an individual webpage with a convenient individual URI (e.g. https://www.timeanddate.com/time/zones/acwst). These or other, similar, resources might be used as a value of the time:timeZone property.""",
        """IANA mantiene una base de datos de husos horarios. Éstas están bien mantenidas y generalmente se consideran autorizadas, pero los ítems individuales no están disponibles en URIs individuales, por tanto, no se pueden utilizar directamente en datos expresados utilizando OWL-Time.
            La BDPedia proporciona un conjunto de recursos correspondientes a los husos horarios de IANA, con una URI para cada uno (por ejemplo, http://dbpedia.org/resource/Australia/Eucla). El Servicio de Reloj Mundial también proporciona una lista de husos horarios con la descripción de cada uno de los disponibles como una página Web individual con una URI adecuada individual (por ejemplo, https://www.timeanddate.com/time/zones/acwst). Éstos, y otros recursos similares, se puden usar como un valor de la propiedad 'huso horario'."""@es .

prov:Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Entity ;
    prov:definition "A bundle is a named set of provenance descriptions, and is itself an Entity, so allowing provenance of provenance to be expressed."@en .

prov:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Entity ;
    prov:definition "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en .

prov:agent a owl:ObjectProperty ;
    rdfs:domain prov:AgentInfluence ;
    rdfs:range prov:Agent .

prov:atLocation a owl:ObjectProperty ;
    rdfs:label "atLocation" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "The Location of any resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity prov:Agent prov:Entity prov:InstantaneousEvent ) ] ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Location ;
    skos:prefLabel "at location"@en ;
    prov:category "expanded" ;
    prov:editorialNote "The naming of prov:atLocation parallels prov:atTime, and is not named prov:hadLocation to avoid conflicting with the convention that prov:had* properties are used on prov:Influence classes."@en,
        "This property is not functional because the many values could be at a variety of granularies (In this building, in this room, in that chair)."@en ;
    prov:inverse "locationOf" ;
    prov:sharesDefinitionWith prov:Location .

prov:definition a owl:AnnotationProperty ;
    rdfs:comment "A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "endedAtTime" ;
    rdfs:comment "The time at which an activity ended. See also prov:startedAtTime."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en ;
    prov:qualifiedForm prov:atTime .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generatedAtTime" ;
    rdfs:comment "The time at which an entity was completely created and is available for use."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "expanded" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en ;
    prov:qualifiedForm prov:atTime .

prov:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "hadPrimarySource" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:prefLabel "had primary source"@en ;
    prov:category "expanded" ;
    prov:component "derivations" ;
    prov:inverse "wasPrimarySourceOf" .

prov:hadRole a owl:ObjectProperty ;
    rdfs:label "hadRole" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "The _optional_ Role that an Entity assumed in the context of an Activity. For example, :baking prov:used :spoon; prov:qualified [ a prov:Usage; prov:entity :spoon; prov:hadRole roles:mixing_implement ]."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Association prov:InstantaneousEvent ) ],
        prov:Influence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Role ;
    prov:category "qualified" ;
    prov:component "agents-responsibility" ;
    prov:editorsDefinition "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end."@en ;
    prov:inverse "wasRoleIn" ;
    prov:sharesDefinitionWith prov:Role .

prov:invalidatedAtTime a owl:DatatypeProperty ;
    rdfs:label "invalidatedAtTime" ;
    rdfs:comment "The time at which an entity was invalidated (i.e., no longer usable)."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "expanded" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedInvalidation o prov:atTime) rdfs:subPropertyOf prov:invalidatedAtTime."@en ;
    prov:qualifiedForm prov:atTime .

prov:qualifiedAssociation a owl:ObjectProperty ;
    dcterms:description "A relation from an activity to an association qualifying the involvement of an agent in the activity." ;
    rdfs:comment "If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ]." ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Association ;
    skos:prefLabel "qualified association"@en .

prov:specializationOf a owl:ObjectProperty ;
    rdfs:label "specializationOf" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:seeAlso prov:alternateOf ;
    rdfs:subPropertyOf prov:alternateOf ;
    prov:category "expanded" ;
    prov:component "alternate" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization"^^xsd:anyURI ;
    prov:inverse "generalizationOf" ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization"^^xsd:anyURI .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "startedAtTime" ;
    rdfs:comment "The time at which an activity started. See also prov:endedAtTime."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en ;
    prov:qualifiedForm prov:atTime .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "wasAssociatedWith" ;
    rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Agent ;
    skos:prefLabel "was associated with"@en ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:inverse "wasAssociateFor" .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "wasGeneratedBy" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Activity ;
    skos:prefLabel "was generated by"@en ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:inverse "generated" .

prov:wasInvalidatedBy a owl:ObjectProperty ;
    rdfs:label "wasInvalidatedBy" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Activity ;
    skos:prefLabel "was invalidated by"@en ;
    prov:category "expanded" ;
    prov:component "entities-activities" ;
    prov:inverse "invalidated" .

prov:wasQuotedFrom a owl:ObjectProperty ;
    rdfs:label "wasQuotedFrom" ;
    rdfs:comment "An entity is derived from an original entity by copying, or 'quoting', some or all of it."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:prefLabel "was quoted from"@en ;
    prov:category "expanded" ;
    prov:component "derivations" ;
    prov:inverse "quotedAs" .

<http://www.w3.org/ns/prov-o> a owl:NamedIndividual .

<http://www.w3.org/ns/prov-o-20130312> a owl:NamedIndividual .

sulo:EndTime a owl:Class ;
    rdfs:label "end time"@en ;
    rdfs:comment "an end time is a time instant at the end of a process/time interval."@en ;
    rdfs:subClassOf sulo:TimeInstant ;
    owl:disjointWith sulo:StartTime ;
    skos:prefLabel "End Time"@en .

sulo:contains a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "A binary relation where the subject entity includes the object entity within its spatial, temporal, structural, or conceptual extent."@en ;
    owl:inverseOf sulo:isIn .

sulo:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    rdfs:comment "has feature is a relation between a thing and an internal, contextual, or externally attributed characteristic."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sulo:Object sulo:Process ) ] ;
    rdfs:range sulo:Feature ;
    owl:inverseOf sulo:isFeatureOf .

sulo:hasItem a owl:ObjectProperty ;
    rdfs:label "has item"@en ;
    rdfs:comment "has item is a relation between a collection and an item contained therein."@en ;
    rdfs:domain sulo:Collection ;
    rdfs:range owl:Thing ;
    owl:inverseOf sulo:isItemIn .

sulo:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:comment "has participant is a relation that describes the participation of a (non-process) thing in a process."@en ;
    rdfs:domain sulo:Process ;
    rdfs:range sulo:Object ;
    owl:inverseOf sulo:isParticipantIn ;
    owl:propertyChainAxiom ( sulo:hasParticipant [ owl:inverseOf sulo:hasFeature ] ) .

sulo:isDirectPartOf a owl:ObjectProperty ;
    rdfs:label "is direct part of"@en ;
    rdfs:comment "is direct part is a non-transitive parthood relation that can be used to specify cardinality constraints between a part and its whole."@en ;
    rdfs:subPropertyOf sulo:isPartOf .

sulo:isItemIn a owl:ObjectProperty ;
    rdfs:label "is item in"@en ;
    rdfs:comment "has item is a relation between an item and the collection in which it contained."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range sulo:Collection ;
    rdfs:subPropertyOf owl:topObjectProperty .

sulo:isParticipantIn a owl:ObjectProperty ;
    rdfs:label "is participant in"@en ;
    rdfs:comment "is participant in is a relation to relate an object and the process in which it participates."@en ;
    rdfs:domain sulo:Object ;
    rdfs:range sulo:Process .

sulo:isTimeOf a owl:ObjectProperty ;
    rdfs:label "is time of" ;
    rdfs:comment "a relation between a time and an object that occurs within it."@en ;
    rdfs:domain sulo:Time ;
    rdfs:range owl:Thing .

sulo:precedes a owl:ObjectProperty ;
    rdfs:label "precedes" ;
    rdfs:comment "A relation in which one process occurs prior to another process."@en ;
    rdfs:domain sulo:Process ;
    rdfs:range sulo:Process .

sulo:refersTo a owl:ObjectProperty ;
    rdfs:label "refers to"@en ;
    rdfs:comment "refers to is a binary relation between an information object and any other object that it mentions, describes, represents, encodes, or otherwise provides information about."@en ;
    rdfs:domain sulo:InformationObject ;
    rdfs:range owl:Thing .

pm:mergedSourceMetadata a owl:NamedIndividual ;
    rdfs:label "Bro Pro"@en,
        "OWL-Time"@en,
        "Tiempo en OWL"@es ;
    dc:creator <https://orcid.org/0000-0003-4727-9435> ;
    dcterms:alternative "SULO"@en ;
    dcterms:bibliographicCitation "Michel Dumontier, Remzi Çelebi, Komal Gilani, Isabelle de Zegher, Katerina Serafimova, Catalina Martínez Costa and Stefan Schulz. SULO - a simplified upper-level ontology. Proceedings of the Joint Ontology Workshops (JOWO) - Episode XI: The Sicilian Summer under the Etna, co-located with the 15th International Conference on Formal Ontology in Information Systems (FOIS 2025), September 8-9, 2025, Catania, Italy"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-7222-3287>,
        <https://orcid.org/0000-0001-8269-8171>,
        <mailto:chris.little@metoffice.gov.uk>,
        "Michael DeBellis Orcid ID: 0000-0002-8824-9577"@en ;
    dcterms:created "2006-09-27"^^xsd:date,
        "2012-11-10"^^xsd:date,
        "2024-11-11",
        "2025-11-28" ;
    dcterms:creator <http://orcid.org/0000-0002-3884-3420>,
        <https://en.wikipedia.org/wiki/Jerry_Hobbs>,
        <mailto:panfeng66@gmail.com>,
        "http://delicias.dia.fi.upm.es/members/DGarijo#me"^^xsd:anyURI,
        "http://www.isi.edu/~gil/"^^xsd:anyURI ;
    dcterms:description "Basic_Bro  provides core metadata annotation properties by reusing SKOS and DCTERMS. It is the foundational module used by all BRO layers and includes only annotation and datatype properties, with no classes or object properties."@en,
        "PROV extension for linking Plans and parts of plans to their respective executions."@en ;
    dcterms:isVersionOf <http://www.w3.org/TR/owl-time> ;
    dcterms:issued "2025-07-11" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/>,
        <https://creativecommons.org/publicdomain/zero/1.0>,
        <https://www.apache.org/licenses/LICENSE-2.0>,
        "http://creativecommons.org/licenses/by-nc-sa/2.0/" ;
    dcterms:modified "2013-05-17"^^xsd:date,
        "2017-04-06"^^xsd:date,
        "2026-05-19" ;
    dcterms:publisher <https://orcid.org/0000-0003-4727-9435> ;
    dcterms:rights "Copyright © 2006-2017 W3C, OGC. W3C and OGC liability, trademark and document use rules apply."@en ;
    dcterms:title "Basic Reusable Ontology 1 big_bro"@en,
        "Simplified Upper Level Ontology"@en,
        "The P-Plan ontology"@en ;
    ns2:authoredBy <https://orcid.org/0000-0003-4727-9435> ;
    vann:preferredNamespacePrefix "p-plan",
        "sulo" ;
    vann:preferredNamespaceUri sulo:,
        "http://purl.org/net/p-plan#" ;
    rdfs:comment "PROV extension for linking Plans and parts of plans to their respective executions. Created by Daniel Garijo and Yolanda Gil",
        "Historical metadata copied unchanged from the uploaded merged ontology header. This record retains upstream attribution, license statements, version notes and merge history; it is not a declaration of interchangeable licenses for the combined ontology."@en,
        "Subset of the W3C PROV-O ontology containing only the terms needed by the Basic Reusable Ontology (Big Bro). IRIs of PROV terms are preserved; content not required by Big Bro has been omitted."@en,
        "The Simplified Upper Level Ontology (SULO) is ontology with a minimal set of classes and relations to guide the development of a personal health knowledge graph."@en ;
    rdfs:seeAlso <http://dx.doi.org/10.3233/SW-150187>,
        <http://www.semantic-web-journal.net/content/time-ontology-extended-non-gregorian-calendar-applications>,
        <http://www.w3.org/TR/owl-time>,
        <http://www.w3.org/TR/prov-o/>,
        <http://www.w3.org/ns/prov> ;
    owl:backwardCompatibleWith sulo:sulo-0.2.3.ttl ;
    owl:priorVersion time:2006,
        sulo:sulo-0.2.3.ttl ;
    owl:versionInfo "0.2.14",
        "1.0.0",
        "1.2",
        "Recommendation version 2013-04-30, subsetted as PROV-Lite for Big Bro"@en ;
    skos:changeNote "2016-06-15 - initial update of OWL-Time - modified to support arbitrary temporal reference systems. ",
        "2016-12-20 - adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.  ",
        "2016-12-20 - restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked \"deprecated\". ",
        "2017-02 - intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration",
        "2017-04-06 - hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal",
        """Imported SULO upper model: https://w3id.org/sulo/
December 17, 2025
Michael DeBellis""",
        """2025-11-29 (M. DeBellis): Created PROV-Lite as a cleaned subset of the W3C PROV-O Turtle serialization for use with the Basic Reusable Ontology (Big Bro).
– Removed duplicate owl:Ontology declarations.
– Moved orphaned ontology metadata triples (label, seeAlso, versionIRI, versionInfo, specializationOf, wasRevisionOf) under this ontology IRI.
– Removed stray non-comment prose that appeared after the :wasStartedBy axiom and caused Turtle parse errors.
– Trimmed PROV terms and axioms not required by Big Bro, without changing the IRIs or logical meaning of the retained PROV terms."""@en,
        """Imported P-Plan Ontology: https://www.opmw.org/model/p-plan/
Source file: https://www.opmw.org/p-plan.owl
Licensed under Creative Commons Attribution-NonCommercial-ShareAlike 2.0 Generic License at: http://creativecommons.org/licenses/by-nc-sa/2.0/
MD 10/8/2026"""@en,
        """Imported W3C Time with SWRL Rules for Allen Interval Algebra from: https://raw.githubusercontent.com/mdebellis/Time-Ontology-With-SWRL-Rules/refs/heads/main/W3C%20Time%20With%20SWRL%20Rules%20V2.ttl  

Merged Time into Bro_Pro and renamed to process_model

MD 10-22-2026"""@en,
        "Merged owl:imports <http://purl.org/net/p-plan#> MD 10/8/2026"@en ;
    skos:editorialNote "Basic_Bro includes the legacy Dublin Core (dc:) namespace only because it is automatically imported by DCTERMS for backward compatibility. BRO users should always use dcterms:* properties and never use dc:* properties."@en ;
    skos:historyNote """2023-09-12  Added SWRL rules and some test cases to implement the logic of the various operators. 

Michael DeBellis mdebellissf@gmail.com""",
        """Update of OWL-Time ontology, extended to support general temporal reference systems. 

Ontology engineering by Simon J D Cox"""@en ;
    skos:note "Basic_Bro reuses annotation and datatype properties from the SKOS and DCTERMS vocabularies. All classes and object properties from imported vocabularies have been removed to provide a clean metadata-only reusable layer."@en ;
    dcat:accessURL sulo:sulo.ttl ;
    foaf:homepage <https://github.com/AIDAVA-DEV/sulo> ;
    schema:funding "This work is partially supported by the AIDAVA project (GA 101057062), as part of the European Union's Horizon Europe research and innovation programme."@en ;
    schema:includedInDataCatalog <https://lov.linkeddata.es/dataset/lov/vocabs/sulo> ;
    ns1:definitionProperty rdfs:comment ;
    ns1:hasRepresentationLanguage <http://omv.ontoware.org/2005/05/ontology#OWL> ;
    ns1:hasSyntax <http://www.w3.org/ns/formats/Turtle> ;
    ns1:prefLabelProperty rdfs:label ;
    ns1:status "active" .

fig8:DraftToIncorporation a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t1CreateTenderDraftTask to t2IncorporateInputsTask"@en ;
    sc:transitionFrom fig8:t1CreateTenderDraftTask ;
    sc:transitionTo fig8:t2IncorporateInputsTask .

fig8:IncorporationToVotingRequest a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t2IncorporateInputsTask to t11SendTenderForVotingTask"@en ;
    sc:transitionFrom fig8:t2IncorporateInputsTask ;
    sc:transitionTo fig8:t11SendTenderForVotingTask .

fig8:PartnerInputToVote a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t222MakeInputTask to t12VoteForTenderTask"@en ;
    sc:transitionFrom fig8:t222MakeInputTask ;
    sc:transitionTo fig8:t12VoteForTenderTask .

fig8:PartnerVoteToEnd a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t12VoteForTenderTask to PartnerVote_End"@en ;
    sc:transitionFrom fig8:t12VoteForTenderTask ;
    sc:transitionTo fig8:PartnerVote_End .

fig8:ReplacementToEnd a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t13ReplaceSupplierTask to SupplierReplaced_End"@en ;
    sc:transitionFrom fig8:t13ReplaceSupplierTask ;
    sc:transitionTo fig8:SupplierReplaced_End .

fig8:StartLeadDraft a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "CFT_Received to t1CreateTenderDraftTask"@en ;
    sc:transitionFrom fig8:CFT_Received ;
    sc:transitionTo fig8:t1CreateTenderDraftTask .

fig8:StartPartnerInput a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "Draft_Received to t222MakeInputTask"@en ;
    sc:transitionFrom fig8:Draft_Received ;
    sc:transitionTo fig8:t222MakeInputTask .

fig8:SubmissionToEnd a owl:NamedIndividual,
        sc:StepTransition ;
    rdfs:label "t3SubmitTenderTask to TenderSubmitted_End"@en ;
    sc:transitionFrom fig8:t3SubmitTenderTask ;
    sc:transitionTo fig8:TenderSubmitted_End .

fig8:sourceSchemaMetadata a owl:NamedIndividual ;
    rdfs:label "Supply-chain collaboration model"@en ;
    dcterms:created "2026-10-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-8824-9577> ;
    dcterms:description "Self-contained experimental extension of the corrected process_model base, prepared for collaborative supply-chain tendering. Reuses P-Plan for planned steps and resource variables, PROV for actual executions and artifacts, and OWL-Time for dated intervals. Adds contextual role assignments, document versions, messages and explicit decision branches. Inspired by Figures 6 and 8 of Kazantsev et al. (2024)."@en ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:source <https://doi.org/10.1080/00207543.2023.2242508>,
        <https://www.michaeldebellis.com/process_model>,
        sc:baseModelMetadata ;
    dcterms:title "Supply-chain collaboration: plans, resources and executions"@en ;
    rdfs:comment "Unchanged header annotations of the supply-chain schema used for this worked example."@en ;
    owl:versionInfo "experimental-collaboration-v2-2026-10-22" ;
    skos:changeNote "2026-10-22 — Changed by ChatGPT. Added TaskStep, CommunicationStep, EventStep, StartEventStep and EndEventStep, plus eventForRole and triggeredByVariable, to support the start/end events and request/reply task shown in Figure 8. Made the six existing task categories subclasses of TaskStep. Declared TaskStep disjoint with EventStep and StartEventStep disjoint with EndEventStep. Preserved the ten existing SWRL rules, the underlying process-model vocabulary and all existing individuals. Kept Figure 8 instances in the separate self-contained supply_chain_figure8 ontology."@en,
        "2026-10-22 — Changed by ChatGPT. Created a separate supply_chain_model ontology from the saved process_model base after synchronizing the later Bro_Pro hadRole and EmptyCollection/Collection repairs. Kept the base vocabulary definitions and all eight existing SWRL rules unchanged. Added a compact collaboration planning/execution vocabulary for step categories, planned roles, document version lineage, messages and decision conditions with explicit alternative transitions. Added two enabled SWRL rules for same-plan flow dependencies and shared input variables between explicitly distinct steps. The paper's shared-output rule and automatic conversion of dependencies to XOR were not adopted. Preserved the base header as sc:baseModelMetadata. No Figure 8 instances, synthetic tests or inferred assertions are included. The separate process_model.ttl file was not modified by this extension."@en ;
    skos:note "The two added resource-dependency rules require distinct steps (owl:differentFrom or owl:AllDifferent) in the same explicitly identified plan. They infer candidate resource links, not execution order, resource contention, exclusive choices or authorization to execute a step. An ExclusiveChoice groups ConditionalTransition alternatives whose DecisionCondition records a decision variable and expected outcome. A workflow controller or human evaluates those conditions and selects the branch; OWL/SWRL here does not enforce executable XOR behavior. No closed-world completeness validation is supplied."@en,
        "Use distinct p-plan:Variable individuals for distinct planned document versions and contributions. p-plan:isOutputVarOf is functional, so one output variable must not be assigned to two explicitly different producing steps. Actual artifacts are p-plan:Entity instances linked through correspondsToVariable; that mapping is also functional in the retained P-Plan ontology."@en ;
    skos:scopeNote "Reusable schema for collaboration plans and their executions. Worked scenario instances belong in separate example ontologies; the Figure 8 tendering plan is provided in supply_chain_figure8.ttl. TaskStep and EventStep separate planned work from planned start/end milestones. CommunicationStep can describe request/reply tasks. Manufacturing-specific MakePart, AssembleProduct and DeliverProduct categories remain for a later specialization."@en .

sc:Approved a owl:NamedIndividual,
        sc:DecisionOutcome ;
    rdfs:label "Approved"@en ;
    owl:differentFrom sc:Rejected .

sc:CollaborationPlan a owl:Class ;
    rdfs:label "Collaboration plan"@en ;
    rdfs:comment "A plan for collaboration between supply-chain participants. Use isStepOfPlan and isVariableOfPlan for its steps and resource variables."@en ;
    rdfs:subClassOf pplan:Plan .

sc:CommunicationStep a owl:Class ;
    rdfs:label "Communication step"@en ;
    rdfs:comment "A planned communication task, which may include sending a request and awaiting a reply. Input/output dependencies can therefore be cyclic at this abstraction level without defining a cyclic control-flow sequence."@en ;
    rdfs:subClassOf sc:TaskStep .

sc:ContributionStep a owl:Class ;
    rdfs:label "Contribution step"@en ;
    rdfs:comment "A planned step that produces a participant contribution to a draft or proposal."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:DocumentSeries a owl:Class ;
    rdfs:label "Document series"@en ;
    rdfs:comment "The continuing document identity that groups versions through versionOf. Individual versions remain distinct artifacts."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

sc:DraftingStep a owl:Class ;
    rdfs:label "Drafting step"@en ;
    rdfs:comment "A planned step that produces an initial draft from its stated inputs."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:LeadSupplierRole a owl:Class ;
    rdfs:label "Lead supplier role"@en ;
    rdfs:comment "The role of leading this collaboration; it is not a permanent classification of the organization."@en ;
    rdfs:subClassOf sc:CollaborationRole .

sc:PartnerReplacementStep a owl:Class ;
    rdfs:label "Partner replacement step"@en ;
    rdfs:comment "A planned step to replace or invite a new collaboration partner."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:PartnerRole a owl:Class ;
    rdfs:label "Partner role"@en ;
    rdfs:comment "The role of an invited or participating partner in this collaboration."@en ;
    rdfs:subClassOf sc:CollaborationRole .

sc:ReviewStep a owl:Class ;
    rdfs:label "Review step"@en ;
    rdfs:comment "A planned evaluation or vote on a document version; its decision output is represented by a DecisionVariable."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:RevisionStep a owl:Class ;
    rdfs:label "Revision step"@en ;
    rdfs:comment "A planned step that incorporates inputs into a new document version. Use a new output variable rather than overwriting the input version."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:SubmissionStep a owl:Class ;
    rdfs:label "Submission step"@en ;
    rdfs:comment "A planned submission of an agreed document to its recipient."@en ;
    rdfs:subClassOf sc:CollaborationStep,
        sc:TaskStep .

sc:baseModelMetadata a owl:NamedIndividual ;
    rdfs:label "Process model"@en ;
    dcterms:created "2026-10-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-8824-9577> ;
    dcterms:description "Self-contained experimental merge of Bro_Pro (Big_Bro/SULO, a PROV-O subset and P-Plan) with OWL-Time. Seven direct-date SWRL rules derive all thirteen Allen base relations using the retained inverse axioms; one additional SWRL rule propagates qualified PROV associations. No catalog or owl:imports resolution is required."@en ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:source pm:mergedSourceMetadata ;
    dcterms:title "Process model: Bro_Pro with OWL-Time and Allen interval rules"@en ;
    rdfs:comment "Temporal rule contract: each interval needs one unambiguous beginning and end, each represented by an instant with a timezone-qualified xsd:dateTimeStamp value using time:inXSDDateTimeStamp. Rules require positive duration and complete timestamps; they do not reason over uncertain or undated endpoints. Allen equality does not imply owl:sameAs. PROV literal start/end properties alone do not supply these endpoint paths. SULO temporal quantities have not been equated with OWL-Time entities. Legacy named temporal examples are retained."@en,
        "Unchanged header annotations from the corrected reusable process_model base used for this extension. The base source file is a separate deliverable."@en ;
    owl:versionInfo "experimental-base-sync-2026-10-22" ;
    skos:changeNote "2026-10-22 review: verified the original six enabled rules against the published W3C Time With SWRL Rules V2.ttl. Retained direct endpoint comparison; changed the before head to intervalBefore; completed finishes/finishedBy; used value comparisons for equal boundaries; guarded against zero/reversed durations. Fixed the January gMonth literal. Restored Bundle-to-Entity and qualified-association typing, corrected the agent domain to AgentInfluence, and added the SWRL equivalent of the PROV association chain. Retained the original header at pm:mergedSourceMetadata. P-Plan and SULO logical axioms and existing test individuals are otherwise unchanged."@en,
        "2026-10-22 — Changed by ChatGPT. Synchronized the reusable process_model base with the later corrections in bro_pro_corrected.ttl before creating any domain-specific extension. Restored both prov:hadRole domains: prov:Influence and the union of prov:Association with prov:InstantaneousEvent. Restored prov:EmptyCollection as an owl:Class and subclass of prov:Collection, and prov:Collection as an owl:Class and subclass of prov:Entity, retaining the existing named-individual declaration for prov:EmptyCollection. Copied the corresponding PROV labels, definitions and source annotations, including the additional annotations on AgentInfluence, Association and Bundle. Verified that the earlier association repairs, seven direct-date Allen SWRL rules, qualified-association rule and January datatype correction were already present; preserved all eight rule bodies without duplication. Retained the ontology IRI, P-Plan and SULO definitions, all existing example individuals and dates, and earlier ontology metadata. No supply-chain vocabulary, test fixtures or inferred assertions were added."@en .

sc:hasFlowDependency a owl:ObjectProperty ;
    rdfs:label "has flow dependency"@en ;
    rdfs:comment "Directed from a producer step to a consumer step sharing an output/input variable. This is a candidate resource-flow dependency, not an asserted control-flow transition or actual temporal ordering."@en ;
    rdfs:domain sc:CollaborationStep ;
    rdfs:range sc:CollaborationStep .

sc:sharesInputVariable a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "shares input variable"@en ;
    rdfs:comment "Two distinct steps in the same plan require the same input variable. This alone does not establish resource contention, mutual exclusion, execution order or a need to choose one step."@en ;
    rdfs:domain sc:CollaborationStep ;
    rdfs:range sc:CollaborationStep .

dcterms:audience a owl:AnnotationProperty .

dcterms:coverage a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:format a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

pplan:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A p-plan:Activity represents the execution process planned in a p-plan:Step" ;
    rdfs:isDefinedBy pplan: ;
    rdfs:subClassOf prov:Activity .

<http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> a owl:NamedIndividual .

xsd:dateTimeStamp rdfs:label "sello de tiempo"@es .

xsd:gYear a rdfs:Datatype .

time:DateTimeDescription a owl:Class ;
    rdfs:label "Date-Time description"@en,
        "descripción de fecha-tiempo"@es ;
    rdfs:comment "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en,
        "Descripción de fecha y tiempo estructurada con valores separados para los diferentes elementos de un sistema calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades año, mes, día restringidas a los correspondientes tipos del XML Schema xsd:gYear, xsd:gMonth y xsd:gDay respectivamente."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ;
            owl:onProperty time:hasTRS ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:gDay ;
            owl:onProperty time:day ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:gMonth ;
            owl:onProperty time:month ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:gYear ;
            owl:onProperty time:year ],
        time:GeneralDateTimeDescription ;
    skos:definition "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en,
        "Descripción de fecha y tiempo estructurada con valores separados para los diferentes elementos de un sistema calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades año, mes, día restringidas a los correspondientes tipos del XML Schema xsd:gYear, xsd:gMonth y xsd:gDay respectivamente."@es .

time:DateTimeInterval a owl:Class ;
    rdfs:label "Date-time interval"@en,
        "intervalo de fecha-hora"@es ;
    rdfs:comment "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en,
        "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ;
    rdfs:subClassOf time:ProperInterval ;
    skos:definition "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en,
        "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ;
    skos:note ":DateTimeInterval can only be used for an interval whose limits coincide with a date-time element aligned to the calendar and timezone indicated. For example, while both have a duration of one day, the 24-hour interval beginning at midnight at the beginning of 8 May in Central Europe can be expressed as a :DateTimeInterval, but the 24-hour interval starting at 1:30pm cannot."@en,
        "'intervalo de fecha-hora' se puede utilizar sólo para un intervalo cuyos límites coinciden con un elemento de fecha-hora alineados con el calendario y la zona horaria indicados. Por ejemplo, aunque ambos tienen una duración de un día, el intervalo de 24 horas que empieza en la media noche del comienzo del 8 mayo en Europa Central se puede expresar como un 'intervalo de fecha-hora', el intervalo de 24 horas que empieza a las 1:30pm no."@es .

time:May_10_1940 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1940-05-10T00:00:00Z"^^xsd:dateTimeStamp .

time:before a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "before"@en,
        "antes"@es ;
    rdfs:comment "Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está antes que otra entidad temporal T2, entonces el final de T1 está antes que el principio de T2. Así, \"antes\" se puede considerar básica para instantes y derivada para intervalos."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalEntity ;
    skos:definition "Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está antes que otra entidad temporal T2, entonces el final de T1 está antes que el principio de T2. Así, \"antes\" se puede considerar básica para instantes y derivada para intervalos."@es .

time:hasTemporalDuration a owl:ObjectProperty ;
    rdfs:label "has temporal duration"@en,
        "tiene duración temporal"@es ;
    rdfs:comment "Duration of a temporal entity."@en,
        "Duración de una entidad temporal."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalDuration ;
    skos:definition "Duration of a temporal entity."@en,
        "Duración de una entidad temporal."@es .

time:hasTime a owl:ObjectProperty ;
    rdfs:label "has time"@en,
        "tiene tiempo"@es ;
    rdfs:comment "Supports the association of a temporal entity (instant or interval) to any thing"@en,
        "Proporciona soporte a la asociación de una entidad temporal (instante o intervalo) a cualquier cosa."@es ;
    rdfs:range time:TemporalEntity ;
    skos:definition "Supports the association of a temporal entity (instant or interval) to any thing"@en,
        "Proporciona soporte a la asociación de una entidad temporal (instante o intervalo) a cualquier cosa."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica arriesgada -añadida en la revisión del 2017 que no ha sido todavía utilizada de forma amplia."@es .

time:hour a owl:DatatypeProperty ;
    rdfs:label "hour"@en,
        "hora"@es ;
    rdfs:comment "Hour position in a calendar-clock system."@en,
        "Posición de hora en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Hour position in a calendar-clock system."@en,
        "Posición de hora en un sistema calendario-reloj."@es .

time:inTemporalPosition a owl:ObjectProperty ;
    rdfs:label "Temporal position"@en,
        "posición temporal"@es ;
    rdfs:comment "Position of a time instant"@en,
        "Posición de un instante de tiempo."@es ;
    rdfs:domain time:Instant ;
    rdfs:range time:TemporalPosition ;
    skos:definition "Position of a time instant"@en,
        "Posición de un instante de tiempo."@es .

time:intervalBefore a owl:ObjectProperty ;
    rdfs:label "interval before"@en,
        "intervalo anterior"@es ;
    rdfs:comment "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en,
        "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:before,
        time:intervalDisjoint ;
    skos:definition "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en,
        "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es .

time:intervalDisjoint a owl:ObjectProperty ;
    rdfs:label "interval disjoint"@en,
        "intervalo disjunto"@es ;
    rdfs:comment "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en,
        "Si un intervalo propio T1 es disjunto con otro intervalo propio T2, entonces el principio de T1 está después del final de T2, o el final de T1 está antes que el principio de T2, es decir, los intervalos no se solapan de ninguna forma, aunque su relación de orden no se conozca."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    skos:definition "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en,
        "Si un intervalo propio T1 es disjunto con otro intervalo propio T2, entonces el principio de T1 está después del final de T2, o el final de T1 está antes que el principio de T2, es decir, los intervalos no se solapan de ninguna forma, aunque su relación de orden no se conozca."@es ;
    skos:note "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is defined in (T.3) as the union of :intervalBefore v :intervalAfter . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with :intervalBefore , :intervalAfter as sub-properties"@en,
        "Esta relación entre intervalos no estaba incluida en las 13 relaciones básicas definidas por Allen (1984), pero está definida en T.3 como la unión de 'intervalo anterior' con 'intervalo posterior'. Sin embargo, esto está fuera de la expresividad de OWL2, por tanto, está implementado como una propiedad explícita, con 'intervalo anterior' e 'intervalo posterior' como sub-propiedades."@es .

time:intervalFinishes a owl:ObjectProperty ;
    rdfs:label "interval finishes"@en,
        "intervalo termina"@es ;
    rdfs:comment "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalOverlaps a owl:ObjectProperty ;
    rdfs:label "interval overlaps"@en,
        "intervalo se solapa"@es ;
    rdfs:comment "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es,
        "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    skos:definition "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es .

time:intervalStarts a owl:ObjectProperty ;
    rdfs:label "interval starts"@en,
        "intervalo empieza"@es ;
    rdfs:comment "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el principio de T2, y el final de T1 es anterior al final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el final de T2, y el final de T1 es anterior al final de T2."@es .

time:minute a owl:DatatypeProperty ;
    rdfs:label "minute"@en,
        "minuto"@es ;
    rdfs:comment "Minute position in a calendar-clock system."@en,
        "Posición de minuto en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Minute position in a calendar-clock system."@en,
        "Posición de minuto en un sistema calendario-reloj."@es .

time:second a owl:DatatypeProperty ;
    rdfs:label "second"@en,
        "segundo"@es ;
    rdfs:comment "Second position in a calendar-clock system."@en,
        "Posición de segundo en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:decimal .

time:unitMonth a owl:NamedIndividual,
        time:TemporalUnit ;
    rdfs:label "Month (unit of temporal duration)"@en ;
    skos:prefLabel "شهر واحد"@ar,
        "Monat"@de,
        "month"@en,
        "mes"@es,
        "mois"@fr,
        "mese"@it,
        "一か月"@jp,
        "한달"@kr,
        "maand"@nl,
        "miesiąc"@pl,
        "один месяц"@ru,
        "一個月"@zh ;
    time:days 0 ;
    time:hours 0 ;
    time:minutes 0 ;
    time:months 1 ;
    time:seconds 0 ;
    time:weeks 0 ;
    time:years 0 .

time:week a owl:DatatypeProperty ;
    rdfs:label "week"@en,
        "semana"@es ;
    rdfs:comment "Week number within the year."@en,
        "Número de semana en el año."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:note "Weeks are numbered differently depending on the calendar in use and the local language or cultural conventions (locale). ISO-8601 specifies that the first week of the year includes at least four days, and that Monday is the first day of the week. In that system, week 1 is the week that contains the first Thursday in the year."@en ;
    skos:scopeNote "Las semanas están numeradas de forma diferente dependiendo del calendario en uso y de las convenciones lingüísticas y culturales locales (locale en inglés). El ISO-8601 especifica que la primera semana del año incluye al menos cuatro días, y que el lunes es el primer día de la semana. En ese sistema, la semana 1 es la semana que contiene el primer jueves del año."@es .

prov:AgentInfluence a owl:Class ;
    rdfs:label "AgentInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Influence ;
    prov:editorsDefinition "AgentInfluence is the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other."@en .

prov:Influence a owl:Class ;
    rdfs:label "Influence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    prov:definition "Influence is the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation."@en .

prov:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso prov:atLocation ;
    rdfs:subClassOf sulo:SpatialObject ;
    skos:historyNote "I made prov:Location a subclass of sulo:Spatial_Object MD 7/20/26"@en ;
    prov:category "expanded" ;
    prov:definition "A location can be an identifiable geographic place (ISO 19112), but it can also be a non-geographic place such as a directory, row, or column. As such, there are numerous ways in which location can be expressed, such as by a coordinate, address, landmark, and so forth."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-location"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

prov:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "An organization is a social or legal institution such as a company, society, etc." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

prov:alternateOf a owl:ObjectProperty ;
    rdfs:label "alternateOf" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:seeAlso prov:specializationOf ;
    prov:category "expanded" ;
    prov:component "alternate" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "Two alternate entities present aspects of the same thing. These aspects may be the same or different, and the alternate entities may or may not overlap in time."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-alternate"^^xsd:anyURI ;
    prov:inverse "alternateOf" ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-alternate"^^xsd:anyURI .

prov:wasRevisionOf a owl:ObjectProperty ;
    rdfs:label "wasRevisionOf" ;
    rdfs:comment "A revision is a derivation that revises an entity into a revised version."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:prefLabel "was revision of"@en ;
    prov:category "expanded" ;
    prov:component "derivations" ;
    prov:inverse "hadRevision" .

sulo:Capability a owl:Class ;
    rdfs:label "capability" ;
    rdfs:comment "A capability is a feature that describes what an entity is able to do, under some set of circumstances."@en ;
    rdfs:subClassOf sulo:Feature ;
    skos:example "the capability to fly, the capabilty to reduce the activation energy of a chemical reaction, the capability to reason"@en ;
    skos:prefLabel "Capability"@en .

sulo:Collection a owl:Class ;
    rdfs:label "collection"@en ;
    rdfs:comment "A collection is an information object for which there may be zero or more items."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty sulo:hasItem ],
        sulo:InformationObject ;
    owl:disjointWith sulo:Quantity ;
    skos:example "a stamp collection, a murder of crows, the arm of a clinical trial"@en ;
    skos:prefLabel "Collection"@en ;
    skos:scopeNote "An information object that aggregates or organizes other information objects. This class is not intended as a general superclass for social groups, physical aggregates, organizations, or arbitrary mathematical sets. MD 7/15/26"@en .

sulo:Quality a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:comment "A quality is a feature that is intrinsically associated with its bearer (or its parts)."@en,
        "the color of an apple, the smoothness of skin, the brightness of a star, the speed of an event"@en ;
    rdfs:subClassOf sulo:Feature ;
    skos:prefLabel "Quality"@en .

sulo:StartTime a owl:Class ;
    rdfs:label "start time"@en ;
    rdfs:comment "a start time is a time instant at the beginning of a process/time interval."@en ;
    rdfs:subClassOf sulo:TimeInstant ;
    skos:prefLabel "Start Time"@en .

sulo:TimeInterval a owl:Class ;
    rdfs:label "time interval" ;
    rdfs:comment "A time interval is a quantity for a continuous and bounded extent of time, characterized by a start time and an end time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom sulo:EndTime ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom sulo:StartTime ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom sulo:Duration ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom sulo:Unit ],
        sulo:Time ;
    skos:prefLabel "Time Interval"@en .

sulo:hasDirectPart a owl:ObjectProperty ;
    rdfs:label "has direct part" ;
    rdfs:comment "has direct part is a non-transitive parthood relation that can be used to specify cardinality constraints between a whole and its parts."@en ;
    rdfs:subPropertyOf sulo:hasPart ;
    owl:inverseOf sulo:isDirectPartOf .

sulo:isFeatureOf a owl:ObjectProperty ;
    rdfs:label "is feature of"@en ;
    rdfs:comment "is feature of is a relation between an internal, contextual, or externally attributed characteristic and some Thing."@en ;
    rdfs:domain sulo:Feature ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( sulo:Object sulo:Process ) ] .

sulo:isIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is in"@en ;
    rdfs:comment "A binary relation where the object entity includes the subject entity within its spatial, temporal, structural, or conceptual extent."@en ;
    rdfs:subPropertyOf owl:topObjectProperty .

sulo:isPartOf a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "is part of is a transitive, reflexive and antisymmetric relation between a part and itself or a part and a whole."@en ;
    rdfs:subPropertyOf sulo:isIn .

fig8:ApprovalCondition a owl:NamedIndividual,
        sc:DecisionCondition ;
    rdfs:label "Partner approves submission"@en ;
    sc:conditionVariable fig8:PartnerDecisionVar ;
    sc:expectedOutcome sc:Approved .

fig8:ApprovalToSubmission a owl:NamedIndividual,
        sc:ConditionalTransition ;
    rdfs:label "t11SendTenderForVotingTask to t3SubmitTenderTask"@en ;
    sc:hasCondition fig8:ApprovalCondition ;
    sc:transitionFrom fig8:t11SendTenderForVotingTask ;
    sc:transitionTo fig8:t3SubmitTenderTask .

fig8:CFT_Received a owl:NamedIndividual,
        sc:StartEventStep ;
    rdfs:label "Call for tender received"@en ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    sc:eventForRole fig8:LeadSupplierRole ;
    sc:triggeredByVariable fig8:CallForTenderVar .

fig8:Draft_Received a owl:NamedIndividual,
        sc:StartEventStep ;
    rdfs:label "Draft received"@en ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    sc:eventForRole fig8:PartnerRole ;
    sc:triggeredByVariable fig8:DraftToPartnerMessageVar .

fig8:PartnerVote_End a owl:NamedIndividual,
        sc:EndEventStep ;
    rdfs:label "End after partner vote"@en ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    sc:eventForRole fig8:PartnerRole .

fig8:RejectionCondition a owl:NamedIndividual,
        sc:DecisionCondition ;
    rdfs:label "Partner rejects submission"@en ;
    sc:conditionVariable fig8:PartnerDecisionVar ;
    sc:expectedOutcome sc:Rejected .

fig8:RejectionToReplacement a owl:NamedIndividual,
        sc:ConditionalTransition ;
    rdfs:label "t11SendTenderForVotingTask to t13ReplaceSupplierTask"@en ;
    sc:hasCondition fig8:RejectionCondition ;
    sc:transitionFrom fig8:t11SendTenderForVotingTask ;
    sc:transitionTo fig8:t13ReplaceSupplierTask .

fig8:SubmittedTenderVar a owl:NamedIndividual,
        sc:DocumentVariable ;
    rdfs:label "Submitted tender artifact"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Modeling detail: the copy or record produced by submission, distinct from the revised draft slot. No actual artifact is asserted."@en .

fig8:SupplierReplaced_End a owl:NamedIndividual,
        sc:EndEventStep ;
    rdfs:label "End after supplier replacement"@en ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    sc:eventForRole fig8:LeadSupplierRole .

fig8:TenderSubmitted_End a owl:NamedIndividual,
        sc:EndEventStep ;
    rdfs:label "End after tender submission"@en ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    sc:eventForRole fig8:LeadSupplierRole .

sc:DecisionResult a owl:Class ;
    rdfs:label "Decision result"@en ;
    rdfs:comment "An actual decision artifact, linked to its DecisionVariable by correspondsToVariable, its subject document by aboutVersion, and its outcome by hasOutcome."@en ;
    rdfs:subClassOf pplan:Entity,
        sulo:InformationObject .

sc:DecisionVariable a owl:Class ;
    rdfs:label "Decision variable"@en ;
    rdfs:comment "A planned slot for a decision result produced by a review or vote. Branch conditions refer to this slot and the expected outcome."@en ;
    rdfs:subClassOf pplan:Variable .

sc:Rejected a owl:NamedIndividual,
        sc:DecisionOutcome ;
    rdfs:label "Rejected"@en .

var:activity a swrl:Variable .

var:agent a swrl:Variable .

var:association a swrl:Variable .

pplan:Plan a owl:Class ;
    rdfs:label "Plan" ;
    rdfs:isDefinedBy pplan: ;
    rdfs:subClassOf prov:Plan ;
    prov:definition "A p-plan:Plan is a specific type of prov:Plan. It is composed of smaller steps that use and produce Variables." .

pplan:hasInputVar a owl:ObjectProperty ;
    rdfs:label "hasInputVar"@en ;
    rdfs:domain pplan:Step ;
    rdfs:isDefinedBy pplan: ;
    rdfs:range pplan:Variable ;
    owl:inverseOf pplan:isInputVarOf ;
    prov:definition "p-plan:hasInputVar binds a p-plan:Step to the p-plan:Variable that takes as input for the planned execution"@en .

time:Duration a owl:Class ;
    rdfs:label "enduración de tiempo",
        "Time duration"@en ;
    rdfs:comment "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en,
        "Duración de una extensión temporal expresada como un número escalado por una unidad temporal."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:unitType ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:numericDuration ],
        time:TemporalDuration ;
    skos:definition "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en,
        "Duración de una extensión temporal expresada como un número escalado por una unidad temporal."@es ;
    skos:note "Alternative to time:DurationDescription to support description of a temporal duration other than using a calendar/clock system."@en,
        "Alternativa a 'descripción de tiempo' para proporcionar descripción soporte a una duración temporal diferente a utilizar un sistema de calendario/reloj."@es .

time:Interval a owl:Class ;
    rdfs:label "Time interval"@en,
        "intervalo de tiempo"@es ;
    rdfs:comment "A temporal entity with an extent or duration"@en,
        "Una entidad temporal con una extensión o duración."@es ;
    rdfs:subClassOf time:TemporalEntity ;
    skos:definition "A temporal entity with an extent or duration"@en,
        "Una entidad temporal con una extensión o duración."@es .

time:September_1_1939 a owl:NamedIndividual ;
    time:inXSDDateTimeStamp "1939-09-01T00:00:00Z"^^xsd:dateTimeStamp .

time:TimePosition a owl:Class ;
    rdfs:label "Time position"@en,
        "posición de tiempo"@es ;
    rdfs:comment "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en,
        "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty time:nominalPosition ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty time:numericPosition ] ) ],
        time:TemporalPosition ;
    skos:definition "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en,
        "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es .

time:day a owl:DatatypeProperty ;
    rdfs:label "day"@en,
        "día"@es ;
    rdfs:comment """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en,
        "Posición de día en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    skos:definition """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en,
        """Posición de día en un sistema calendario-reloj.

El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por una representación específica de un día de calendario de cualquier calendario."""@es .

time:days a owl:DatatypeProperty ;
    rdfs:label "days duration"@en,
        "duración en días"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in days"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en días."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal ;
    skos:definition "length of, or element of the length of, a temporal extent expressed in days"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en días."@es .

time:hours a owl:DatatypeProperty ;
    rdfs:label "hours duration"@en,
        "duración en horas"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in hours"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en horas."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal ;
    skos:definition "length of, or element of the length of, a temporal extent expressed in hours"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en horas."@es .

time:minutes a owl:DatatypeProperty ;
    rdfs:label "minutes"@en,
        "minutos"@es ;
    rdfs:comment "length, or element of, a temporal extent expressed in minutes"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en minutos."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal ;
    skos:definition "length, or element of, a temporal extent expressed in minutes"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en minutos."@es .

time:months a owl:DatatypeProperty ;
    rdfs:label "months duration"@en,
        "duración en meses"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in months"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en meses."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal ;
    skos:definition "length of, or element of the length of, a temporal extent expressed in months"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en meses."@es .

time:seconds a owl:DatatypeProperty ;
    rdfs:label "seconds duration"@en,
        "duración en segundos"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in seconds"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en segundos."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso <http://www.bipm.org/en/publications/si-brochure/second.html> .

time:weeks a owl:DatatypeProperty ;
    rdfs:label "weeks duration"@en,
        "duración en semanas"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in weeks"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en semanas."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal .

time:year a owl:DatatypeProperty ;
    rdfs:label "year"@en ;
    rdfs:comment """Year position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar year from any calendar. """@en,
        """Posición de año en un sistema calendario-reloj.

l rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un año de calendario de un calendario cualquiera."""@es ;
    rdfs:domain time:GeneralDateTimeDescription .

time:years a owl:DatatypeProperty ;
    rdfs:label "years duration"@en,
        "duración en años"@es ;
    rdfs:comment "length of, or element of the length of, a temporal extent expressed in years"@en,
        "Longitud de, o elemento de la longitud de, una extensión temporal expresada en años."@es ;
    rdfs:domain time:GeneralDurationDescription ;
    rdfs:range xsd:decimal .

prov:Association a owl:Class ;
    rdfs:label "Association" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:AgentInfluence ;
    prov:definition "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity. It further allows for a plan to be specified, which is the plan intended by the agent to achieve some goals in the context of this activity."@en .

prov:Plan a owl:Class ;
    rdfs:label "Plan" ;
    rdfs:comment "There exist no prescriptive requirement on the nature of plans, their representation, the actions or steps they consist of, or their intended goals. Since plans may evolve over time, it may become necessary to track their provenance, so plans themselves are entities. Representing the plan explicitly in the provenance can be useful for various tasks: for example, to validate the execution as represented in the provenance record, to manage expectation failures, or to provide explanations."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Entity ;
    prov:category "expanded",
        "qualified" ;
    prov:component "agents-responsibility" ;
    prov:definition "A plan is an entity that represents a set of actions or steps intended by one or more agents to achieve some goals." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI .

prov:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso prov:hadRole ;
    prov:category "qualified" ;
    prov:component "agents-responsibility" ;
    prov:definition "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-role"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

sulo:Duration a owl:Class ;
    rdfs:label "duration"@en ;
    rdfs:comment "Duration is a temporal quantity that represents the extent or (non-negative) amount of time that elapses between two temporal points, typically the start and end of a time interval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasValue ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] ) ] ],
        sulo:Time ;
    skos:prefLabel "Duration"@en .

sulo:Quantity a owl:Class ;
    rdfs:label "quantity"@en ;
    rdfs:comment "A quantity is an information object that represents the magnitude (and unit) of an object or process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom sulo:Unit ],
        sulo:InformationObject ;
    skos:prefLabel "Quantity"@en .

sulo:Role a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:comment "A role is a feature that describes a context-dependent behaviour."@en ;
    rdfs:subClassOf sulo:Feature ;
    skos:example "a teacher, a student, a catalyst, a substrate, a product, a patient"@en ;
    skos:prefLabel "Role"@en .

sulo:SpatialObject a owl:Class ;
    rdfs:label "spatial object"@en ;
    rdfs:comment "A spatial object is an object that occupies space"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sulo:SpatialObject ;
            owl:onProperty sulo:hasPart ],
        sulo:Object ;
    skos:example "a mountain, a planet, a photon, the lining of the stomach, the cavity of the stomach, the space between mars and earth"@en ;
    skos:prefLabel "Spatial Object"@en .

sulo:Unit a owl:Class ;
    rdfs:label "unit" ;
    rdfs:comment "a unit is a standardized quantity that is used as a reference for a particular quantity."@en ;
    rdfs:subClassOf sulo:Quantity ;
    skos:prefLabel "Unit"@en .

sulo:hasValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has value"@en ;
    rdfs:comment "has value is the (only) data type attribute to store the values of information objects."@en ;
    rdfs:domain sulo:InformationObject .

fig8:CallForTenderVar a owl:NamedIndividual,
        sc:DocumentVariable ;
    rdfs:label "External call for tender"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "External input. No step in this plan produces the call for tender."@en .

fig8:ContributionToLeadMessageVar a owl:NamedIndividual,
        sc:MessageVariable ;
    rdfs:label "Partner contribution sent to lead supplier"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Second dashed message exchange: partner input to incorporation."@en ;
    sc:messagePayloadVariable fig8:PartnerContributionVar ;
    sc:plannedReceiverRole fig8:LeadSupplierRole ;
    sc:plannedSenderRole fig8:PartnerRole .

fig8:InvitedPartner a owl:NamedIndividual,
        prov:Organization ;
    rdfs:label "Invited partner (example organization)"@en ;
    rdfs:comment "Placeholder organization for the Partner lane in Figure 8."@en .

fig8:VoteToLeadMessageVar a owl:NamedIndividual,
        sc:MessageVariable ;
    rdfs:label "Partner vote returned to lead supplier"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Fourth dashed message exchange: partner vote back to the send-and-await task."@en ;
    sc:messagePayloadVariable fig8:PartnerDecisionVar ;
    sc:plannedReceiverRole fig8:LeadSupplierRole ;
    sc:plannedSenderRole fig8:PartnerRole .

fig8:VotingRequestMessageVar a owl:NamedIndividual,
        sc:MessageVariable ;
    rdfs:label "Revised tender sent for voting"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Third dashed message exchange: send-for-voting to partner vote."@en ;
    sc:messagePayloadVariable fig8:RevisedTenderVar ;
    sc:plannedReceiverRole fig8:PartnerRole ;
    sc:plannedSenderRole fig8:LeadSupplierRole .

sc:ExclusiveChoice a owl:Class ;
    rdfs:label "Exclusive choice"@en ;
    rdfs:comment "An explicitly modeled choice grouping alternative ConditionalTransitions. The alternatives should share the stated choiceAfterStep and have explicit conditions. Runtime branch selection and completeness checks belong to a controller or human."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

sc:Message a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:comment "An actual message artifact, with sender, recipient and payload. Generation and use by actual activities are expressed using PROV."@en ;
    rdfs:subClassOf pplan:Entity,
        sulo:InformationObject .

sc:StartEventStep a owl:Class ;
    rdfs:label "Start event step"@en ;
    rdfs:comment "A planned start event. triggeredByVariable describes the planned information whose arrival triggers the event; it does not generate that information."@en ;
    rdfs:subClassOf sc:EventStep ;
    owl:disjointWith sc:EndEventStep .

pplan:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy pplan: ;
    rdfs:subClassOf prov:Entity ;
    prov:definition "a p-plan:Entity represents the input of the execution of a p-plan:Activity. It corresponds to a p-plan:Variable." .

pplan:isStepOfPlan a owl:ObjectProperty ;
    rdfs:label "isStepOfPlan"@en ;
    rdfs:domain pplan:Step ;
    rdfs:isDefinedBy pplan: ;
    rdfs:range pplan:Plan ;
    prov:definition "p-plan:isStepOfPlan links a p-plan:Step to the p-plan:Plan which it corresponds to."@en .

rdfs:label a owl:AnnotationProperty ;
    rdfs:comment ""@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

time:TemporalDuration a owl:Class ;
    rdfs:label "Temporal duration"@en,
        "duración temporal"@es ;
    rdfs:comment "Time extent; duration of a time interval separate from its particular start position"@en,
        "Extensión de tiempo; duración de un intervalo de tiempo independiente de su posición de inicio particular."@es ;
    skos:definition "Time extent; duration of a time interval separate from its particular start position"@en,
        "Extensión de tiempo; duración de un intervalo de tiempo independiente de su posición de inicio particular."@es .

time:TemporalPosition a owl:Class ;
    rdfs:label "Temporal position"@en,
        "posición temporal"@es ;
    rdfs:comment "A position on a time-line"@en,
        "Una posición sobre una línea de tiempo."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hasTRS ] ;
    skos:definition "A position on a time-line"@en,
        "Una posición sobre una línea de tiempo."@es .

time:hasTRS a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Temporal reference system used"@en,
        "sistema de referencia temporal utilizado"@es ;
    rdfs:comment "The temporal reference system used by a temporal position or extent description. "@en,
        "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( time:GeneralDurationDescription time:TemporalPosition ) ] ;
    rdfs:range time:TRS ;
    skos:definition "The temporal reference system used by a temporal position or extent description. "@en,
        "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es .

time:intervalIn a owl:ObjectProperty ;
    rdfs:label "interval in"@en,
        "intervalo interior"@es ;
    rdfs:comment "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en,
        "Si un intervalo propio T1 es un intervalo interior a otro intervalo propio T2, entonces el principio de T1 está después del principio de T2 o coincide con el principio de T2, y el final de T1 está antes que el final de T2, o coincide con el final de T2, excepto que el final de T1 puede no coincidir con el final de T2 si el principio de T1 coincide con el principio de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    skos:definition "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en,
        "Si un intervalo propio T1 es un intervalo interior a otro intervalo propio T2, entonces el principio de T1 está después del principio de T2 o coincide con el principio de T2, y el final de T1 está antes que el final de T2, o coincide con el final de T2, excepto que el final de T1 puede no coincidir con el final de T2 si el principio de T1 coincide con el principio de T2."@es ;
    skos:note "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is referred to as 'an important relationship' in Allen and Ferguson (1997). It is the disjoint union of :intervalStarts v :intervalDuring v :intervalFinishes . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with :intervalStarts , :intervalDuring , :intervalFinishes as sub-properties"@en,
        "Esta relación entre intervalos no estaba incluida en las 13 relaciones básicas definidas por Allen (1984), pero se hace referencia a ella como \"una relación importante\" en Allen y Ferguson (1997). Es la unión disjunta de 'intervalo empieza', 'intervalo durante' y con 'intervalo termina'. Sin embargo, esto está fuera de la expresividad de OWL2, por tanto, se implementa como una propiedad explícita, con 'intervalo empieza', 'intervalo durante' e 'intervalo termina' como sub-propiedades."@es .

time:month a owl:DatatypeProperty ;
    rdfs:label "month"@en,
        "mes"@es ;
    rdfs:comment """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en,
        """Posición de mes en un sistema calendario-reloj.
    El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un mes de calendario de un calendario cualquiera."""@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    skos:definition """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en,
        """Posición de mes en un sistema calendario-reloj.
            El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un mes de calendario de un calendario cualquiera."""@es .

time:unitType a owl:ObjectProperty ;
    rdfs:label "temporal unit type"@en,
        "tipo de unidad temporal"@es ;
    rdfs:comment "The temporal unit which provides the precision of a date-time value or scale of a temporal extent"@en,
        "La unidad de tiempo que proporciona la precisión de un valor fecha-hora o la escala de una extensión temporal."@es ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( time:Duration time:GeneralDateTimeDescription ) ] ;
    rdfs:range time:TemporalUnit .

prov:atTime a owl:DatatypeProperty ;
    rdfs:label "atTime" ;
    rdfs:comment "The time at which an InstantaneousEvent occurred, in the form of xsd:dateTime."@en ;
    rdfs:domain prov:InstantaneousEvent ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "qualified" ;
    prov:component "entities-activities" ;
    prov:sharesDefinitionWith prov:InstantaneousEvent ;
    prov:unqualifiedForm prov:endedAtTime,
        prov:generatedAtTime,
        prov:invalidatedAtTime,
        prov:startedAtTime .

sulo:TimeInstant a owl:Class ;
    rdfs:label "time instant"@en ;
    rdfs:comment "time instant is a quantity of time a particular moment in time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:dateTime xsd:dateTimeStamp ) ] ;
            owl:onProperty sulo:hasValue ],
        sulo:Time ;
    skos:prefLabel "Time Instant"@en .

fig8:DraftToPartnerMessageVar a owl:NamedIndividual,
        sc:MessageVariable ;
    rdfs:label "Initial draft sent to partner"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "First dashed message exchange: draft creation to partner input."@en ;
    sc:messagePayloadVariable fig8:InitialDraftVar ;
    sc:plannedReceiverRole fig8:PartnerRole ;
    sc:plannedSenderRole fig8:LeadSupplierRole .

fig8:PartnerContributionVar a owl:NamedIndividual,
        sc:DocumentVariable ;
    rdfs:label "Partner contribution"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Partner input as its own document/artifact slot, not a second producer of the initial draft."@en .

fig8:t12VoteForTenderTask a owl:NamedIndividual,
        sc:ReviewStep ;
    rdfs:label "Vote on tender submission"@en ;
    pplan:hasInputVar fig8:RevisedTenderVar,
        fig8:VotingRequestMessageVar ;
    pplan:hasOutputVar fig8:PartnerDecisionVar,
        fig8:VoteToLeadMessageVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Partner task t12VoteForTenderTask. Reviews the revised tender on receipt of the voting request, produces one decision-result slot and returns that decision to the lead supplier."@en .

fig8:t13ReplaceSupplierTask a owl:NamedIndividual,
        sc:PartnerReplacementStep ;
    rdfs:label "Replace supplier / invite an alternative partner"@en ;
    pplan:hasInputVar fig8:PartnerDecisionVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Replacement task on the rejection branch. The accompanying text describes inviting an alternative partner; Figure 8 terminates this branch without drawing a retry loop or a third participant lane."@en .

fig8:t1CreateTenderDraftTask a owl:NamedIndividual,
        sc:DraftingStep ;
    rdfs:label "Create tender draft"@en ;
    pplan:hasInputVar fig8:CallForTenderVar ;
    pplan:hasOutputVar fig8:DraftToPartnerMessageVar,
        fig8:InitialDraftVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Lead-supplier task t1CreateTenderDraftTask in Figure 8. Uses the external call for tender and produces the initial draft and its outgoing message."@en .

fig8:t222MakeInputTask a owl:NamedIndividual,
        sc:ContributionStep ;
    rdfs:label "Provide input to the tender"@en ;
    pplan:hasInputVar fig8:DraftToPartnerMessageVar,
        fig8:InitialDraftVar ;
    pplan:hasOutputVar fig8:ContributionToLeadMessageVar,
        fig8:PartnerContributionVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Partner task t222MakeInputTask. Produces a distinct partner-contribution slot and sends that contribution to the lead supplier."@en .

fig8:t2IncorporateInputsTask a owl:NamedIndividual,
        sc:RevisionStep ;
    rdfs:label "Incorporate partner input"@en ;
    pplan:hasInputVar fig8:ContributionToLeadMessageVar,
        fig8:InitialDraftVar,
        fig8:PartnerContributionVar ;
    pplan:hasOutputVar fig8:RevisedTenderVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Lead-supplier incorporation task shown as t2IncorporteInputsTask in the figure. The local identifier corrects that spelling. Produces a new revised-tender slot instead of reusing the initial-draft output variable."@en .

fig8:t3SubmitTenderTask a owl:NamedIndividual,
        sc:SubmissionStep ;
    rdfs:label "Submit tender"@en ;
    pplan:hasInputVar fig8:PartnerDecisionVar,
        fig8:RevisedTenderVar ;
    pplan:hasOutputVar fig8:SubmittedTenderVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Submission task on the approval branch. The modeled submitted-tender variable denotes the submitted copy or submission artifact; it is distinct from the revised draft slot."@en .

sc:ConditionalTransition a owl:Class ;
    rdfs:label "Conditional transition"@en ;
    rdfs:comment "A possible transition with an explicit DecisionCondition. Missing conditions are incomplete data, not unconditional permission to proceed."@en ;
    rdfs:subClassOf sc:StepTransition .

sc:DecisionOutcome a owl:Class ;
    rdfs:label "Decision outcome"@en ;
    rdfs:comment "An outcome value for a decision. Approved and Rejected are supplied as distinct reusable values; further values may be added."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

sc:EndEventStep a owl:Class ;
    rdfs:label "End event step"@en ;
    rdfs:comment "A planned end event for a participant path, not necessarily the end of every participant in the collaboration."@en ;
    rdfs:subClassOf sc:EventStep .

sc:EventStep a owl:Class ;
    rdfs:label "Event step"@en ;
    rdfs:comment "A planned workflow event or milestone. This is a description in a plan, not an actual prov:InstantaneousEvent or time:Instant. eventForRole identifies its participant lane."@en ;
    rdfs:subClassOf sc:CollaborationStep .

scvar:plan a swrl:Variable .

scvar:resource a swrl:Variable .

sulo:Time a owl:Class ;
    rdfs:label "time"@en ;
    rdfs:comment "time is a quantity pertaining to the duration of some interval of time or a particular instant of time (against some frame of reference)."@en ;
    rdfs:subClassOf sulo:Quantity ;
    owl:disjointUnionOf ( sulo:Duration sulo:TimeInstant sulo:TimeInterval ) ;
    owl:disjointWith sulo:Unit ;
    skos:prefLabel "Time"@en .

fig8:InitialDraftVar a owl:NamedIndividual,
        sc:DocumentVariable ;
    rdfs:label "Initial tender draft"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Initial document version produced by the lead supplier; distinct from both partner contributions and the revised tender."@en .

sc:DecisionCondition a owl:Class ;
    rdfs:label "Decision condition"@en ;
    rdfs:comment "A declarative condition requiring the result in conditionVariable to have expectedOutcome. This vocabulary records the condition; it does not evaluate it."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

sc:DocumentVariable a owl:Class ;
    rdfs:label "Document variable"@en ;
    rdfs:comment "A planned input or output slot for one document version or contribution. It is not the actual document artifact."@en ;
    rdfs:subClassOf pplan:Variable .

sc:DocumentVersion a owl:Class ;
    rdfs:label "Document version"@en ;
    rdfs:comment "A particular document snapshot or contribution artifact. Use correspondsToVariable, versionOf and previousVersion to distinguish its planned slot, document series and revision lineage."@en ;
    rdfs:subClassOf pplan:Entity,
        sulo:InformationObject .

skos:note a owl:AnnotationProperty ;
    rdfs:label "note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A general note, for any purpose."@en ;
    skos:scopeNote "This property may be used directly, or as a super-property for more specific note types."@en .

prov:InstantaneousEvent a owl:Class ;
    rdfs:label "InstantaneousEvent" ;
    rdfs:comment "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf sulo:Process ;
    skos:prefLabel "Instantaneous Event"@en ;
    prov:category "qualified" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#dfn-event"^^xsd:anyURI ;
    prov:definition "The PROV data model is implicitly based on a notion of instantaneous events (or just events), that mark transitions in the world. Events include generation, usage, or invalidation of entities, as well as starting or ending of activities. This notion of event is not first-class in the data model, but it is useful for explaining its other concepts and its semantics."@en .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom" ;
    rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    skos:prefLabel "was derived from" ;
    prov:category "starting-point" ;
    prov:component "derivations" ;
    prov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
    prov:inverse "hadDerivation" .

fig8:LeadSupplier a owl:NamedIndividual,
        prov:Organization ;
    rdfs:label "Lead supplier (example organization)"@en ;
    rdfs:comment "Placeholder organization for the Lead Supplier lane in Figure 8."@en .

fig8:RevisedTenderVar a owl:NamedIndividual,
        sc:DocumentVariable ;
    rdfs:label "Tender revised with partner input"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "Revised document version produced by incorporation and subsequently circulated for voting and submission."@en .

fig8:t11SendTenderForVotingTask a owl:NamedIndividual,
        sc:CommunicationStep ;
    rdfs:label "Send tender for voting and await reply"@en ;
    pplan:hasInputVar fig8:RevisedTenderVar,
        fig8:VoteToLeadMessageVar ;
    pplan:hasOutputVar fig8:VotingRequestMessageVar ;
    pplan:isStepOfPlan fig8:TenderingPlan ;
    rdfs:comment "Corresponds to t11SendTenderForVotingTask. The send-and-await interpretation accounts for both the outgoing voting request and the returning vote drawn at this task. The branch is considered after the reply is available."@en .

sc:CollaborationRole a owl:Class ;
    rdfs:label "Collaboration role"@en ;
    rdfs:comment "A context-dependent function in a collaboration. Assign a role instance to an agent through PlannedAssignment or, for an execution, a PROV Association with hadRole."@en ;
    rdfs:subClassOf prov:Role,
        sulo:Role .

rdfs:seeAlso a owl:AnnotationProperty ;
    rdfs:comment ""@en .

sulo:Feature a owl:Class ;
    rdfs:label "feature"@en ;
    rdfs:comment "A feature is any characteristic that stems from the intrisinc structure and/or context"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isFeatureOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( sulo:Object sulo:Process ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom sulo:Feature ;
            owl:onProperty sulo:hasPart ],
        sulo:Object ;
    owl:disjointUnionOf ( sulo:Capability sulo:InformationObject sulo:Quality sulo:Role ) ;
    owl:disjointWith sulo:SpatialObject ;
    skos:example "the capability to fly, a collection of cards, a measured height of 170cm."@en ;
    skos:prefLabel "Feature"@en .

fig8:PartnerDecisionVar a owl:NamedIndividual,
        sc:DecisionVariable ;
    rdfs:label "Partner decision on submission"@en ;
    pplan:isVariableOfPlan fig8:TenderingPlan ;
    rdfs:comment "One planned decision slot produced by the partner vote. The two branch conditions inspect its realized outcome; neither outcome is asserted in this plan."@en .

sc:MessageVariable a owl:Class ;
    rdfs:label "Message variable"@en ;
    rdfs:comment "A planned message slot, with contextual sender/receiver roles and an optional payload variable. It is not a sent message."@en ;
    rdfs:subClassOf pplan:Variable .

sc:TaskStep a owl:Class ;
    rdfs:label "Task step"@en ;
    rdfs:comment "A planned unit of work in a collaboration. Distinguished from a planned event; actual performances are StepExecution individuals."@en ;
    rdfs:subClassOf sc:CollaborationStep ;
    owl:disjointWith sc:EventStep .

time:DayOfWeek a owl:Class ;
    rdfs:label "Day of week"@en,
        "día de la semana"@es ;
    rdfs:comment "The day of week"@en,
        "El día de la semana"@es ;
    rdfs:subClassOf owl:Thing ;
    skos:changeNote """Remove enumeration from definition, in order to allow other days to be used when required in other calendars. 
NOTE: existing days are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:Monday
      time:Tuesday
      time:Wednesday
      time:Thursday
      time:Friday
      time:Saturday
      time:Sunday
    ) ;"""@en ;
    skos:definition "The day of week"@en,
        "El día de la semana"@es ;
    skos:note "Membership of the class :DayOfWeek is open, to allow for alternative week lengths and different day names."@en,
        "La pertenencia a la clase 'día de la semana' está abierta, para permitir longitudes de semana alternativas y diferentes nombres de días."@es .

time:TemporalUnit a owl:Class ;
    rdfs:label "Temporal unit"@en,
        "unidad de tiempo"@es ;
    rdfs:comment "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en,
        "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
    rdfs:subClassOf time:TemporalDuration ;
    skos:changeNote """Remove enumeration from definition, in order to allow other units to be used when required in other coordinate systems. 
NOTE: existing units are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:unitSecond
      time:unitMinute
      time:unitHour
      time:unitDay
      time:unitWeek
      time:unitMonth
      time:unitYear
    ) ;"""@en ;
    skos:definition "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en,
        "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
    skos:note "Membership of the class TemporalUnit is open, to allow for other temporal units used in some technical applications (e.g. millions of years, Baha'i month)."@en,
        "La pertenencia de la clase 'unidad de tiempo' está abierta, para permitir otras unidades de tiempo utilizadas en algunas aplicaciones técnicas (por ejemplo, millones de años o el mes Baha'i)."@es .

pplan:Step a owl:Class ;
    rdfs:label "Step" ;
    rdfs:isDefinedBy pplan: ;
    prov:definition "A p-plan:Step represents the planned execution activity" .

prov:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith prov:InstantaneousEvent ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI .

sulo:Object a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:comment "An object is an entity that maintains its identity through time, and does not have processes as its parts." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty sulo:hasPart ;
                    owl:someValuesFrom sulo:Process ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom sulo:Object ;
            owl:onProperty sulo:hasPart ] ;
    owl:disjointWith sulo:Process ;
    skos:example "a heart, the function to pump blood, the role of a doctor"@en ;
    skos:prefLabel "Object"@en .

fig8:PartnerRole a owl:NamedIndividual,
        sc:PartnerRole ;
    rdfs:label "Invited partner role in this tendering plan"@en .

owl:Thing a owl:Class .

time:GeneralDurationDescription a owl:Class ;
    rdfs:label "Generalized duration description"@en,
        "descripción de duración generalizada"@es ;
    rdfs:comment "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hasTRS ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:days ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hours ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:minutes ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:months ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:seconds ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:weeks ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:years ],
        time:TemporalDuration ;
    skos:definition "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es ;
    skos:note "The extent of a time duration expressed as a GeneralDurationDescription depends on the Temporal Reference System. In some calendars the length of the week or month is not constant within the year. Therefore, a value like \"2.5 months\" may not necessarily be exactly compared with a similar duration expressed in terms of weeks or days. When non-earth-based calendars are considered even more care must be taken in comparing durations."@en,
        "La extensión de una duración de tiempo expresada como una 'descripción de duración general' depende del Sistema de Referencia Temporal. En algunos calendarios la longitud de la semana o del mes no es constante a lo largo del año. Por tanto, un valor como \"25 meses\" puede no ser necesariamente ser comparado con un duración similar expresada en términos de semanas o días. Cuando se consideran calendarios que no están basados en el movimiento de la Tierra, se deben tomar incluso más precauciones en la comparación de duraciones."@es .

sulo:hasPart a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part." ;
    rdfs:subPropertyOf sulo:contains ;
    owl:inverseOf sulo:isPartOf .

sc:PlannedAssignment a owl:Class ;
    rdfs:label "Planned assignment"@en ;
    rdfs:comment "An intended agent/role assignment for a planned step. Use assignmentForStep, assignedAgent and assignedRole. This is not a PROV Association and creates no actual wasAssociatedWith assertion."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

scvar:consumer a swrl:Variable .

scvar:producer a swrl:Variable .

pplan:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:isDefinedBy pplan: ;
    prov:definition "A p-plan:Variable represents a description of the input of the planned Activity (p-plan:Step)" .

time:TemporalEntity a owl:Class ;
    rdfs:label "Temporal entity"@en,
        "entidad temporal"@es ;
    rdfs:comment "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( time:Instant time:Interval ) ] ;
    skos:definition "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es .

sc:StepTransition a owl:Class ;
    rdfs:label "Step transition"@en ;
    rdfs:comment "An explicitly modeled possible control-flow transition from transitionFrom to transitionTo. It does not assert actual execution or temporal precedence."@en ;
    rdfs:subClassOf prov:Entity,
        sulo:InformationObject .

time:Instant a owl:Class ;
    rdfs:label "Time instant"@en,
        "instante de tiempo."@es ;
    rdfs:comment "A temporal entity with zero extent or duration"@en,
        "Una entidad temporal con una extensión o duración cero."@es ;
    rdfs:subClassOf time:TemporalEntity ;
    owl:disjointWith time:ProperInterval ;
    skos:definition "A temporal entity with zero extent or duration"@en,
        "Una entidad temporal con una extensión o duración cero."@es .

prov:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf sulo:Process ;
    owl:disjointWith prov:Entity ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity"^^xsd:anyURI .

fig8:LeadSupplierRole a owl:NamedIndividual,
        sc:LeadSupplierRole ;
    rdfs:label "Lead supplier role in this tendering plan"@en .

dcterms:relation a owl:AnnotationProperty .

time:hasBeginning a owl:ObjectProperty ;
    rdfs:label "has beginning"@en,
        "tiene principio"@es ;
    rdfs:comment "Beginning of a temporal entity"@en,
        "Comienzo de una entidad temporal."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant ;
    rdfs:subPropertyOf time:hasTime ;
    skos:definition "Beginning of a temporal entity."@en,
        "Comienzo de una entidad temporal."@es .

time:hasEnd a owl:ObjectProperty ;
    rdfs:label "has end"@en,
        "tiene fin"@es ;
    rdfs:comment "End of a temporal entity."@en,
        "Final de una entidad temporal."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant ;
    rdfs:subPropertyOf time:hasTime ;
    skos:definition "End of a temporal entity."@en,
        "Final de una entidad temporal."@es .

sulo:Process a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:comment "a process is a entity that unfolds in time, has temporal parts, and has objects that participate in the process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sulo:Process ;
            owl:onProperty sulo:hasPart ] ;
    skos:example "the process of diagnosing a problem condition, the process of walking down the street, the process of teaching a class"@en ;
    skos:prefLabel "Process"@en .

var:endA a swrl:Variable .

var:endB a swrl:Variable .

var:startA a swrl:Variable .

var:startB a swrl:Variable .

pplan: a owl:NamedIndividual,
        owl:Thing .

time:GeneralDateTimeDescription a owl:Class ;
    rdfs:label "Generalized date-time description"@en,
        "descripción de fecha-hora generalizada"@es ;
    rdfs:comment "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en,
        "Descripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:unitType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:dayOfWeek ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:monthOfYear ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:timeZone ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:day ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:dayOfYear ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hour ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:minute ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:month ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:second ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:week ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:year ],
        time:TemporalPosition ;
    skos:definition "enDescripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj.",
        "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en ;
    skos:note "esSome combinations of properties are redundant - for example, within a specified :year if :dayOfYear is provided then :day and :month can be computed, and vice versa. Individual values should be consistent with each other and the calendar, indicated through the value of the :hasTRS property.",
        "Algunas combinaciones de propiedades son redundantes - por ejemplo, dentro de un 'año' especificado si se proporciona 'día del año' entonces 'día' y 'mes' se pueden computar, y viceversa. Los valores individuales deberían ser consistentes entre ellos y con el calendario, indicado a través del valor de la propiedad 'tiene TRS'."@es .

sulo:InformationObject a owl:Class ;
    rdfs:label "information object"@en ;
    rdfs:comment "an information object is a feature that represents, is about, or encodes some information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sulo:InformationObject ;
            owl:onProperty sulo:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty sulo:hasValue ],
        sulo:Feature ;
    skos:prefLabel "Information Object"@en .

var:endDateB a swrl:Variable .

var:startDateA a swrl:Variable .

sc:CollaborationStep a owl:Class ;
    rdfs:label "Collaboration step"@en ;
    rdfs:comment "A planned step description. It is an information object, not an occurrence. Actual performances are StepExecution instances linked with correspondsToStep."@en ;
    rdfs:subClassOf pplan:Step,
        prov:Entity,
        sulo:InformationObject .

var:a a swrl:Variable .

var:b a swrl:Variable .

fig8:TenderingPlan a owl:NamedIndividual,
        sc:CollaborationPlan ;
    rdfs:label "Figure 8 collaborative tendering plan"@en ;
    dcterms:source <https://doi.org/10.1080/00207543.2023.2242508> ;
    rdfs:comment "Entry point for the example. The lead supplier and invited partner participate in one collaboration plan with separate role assignments and event lanes."@en .

var:endDateA a swrl:Variable .

var:startDateB a swrl:Variable .

time:inXSDDateTimeStamp a owl:DatatypeProperty ;
    rdfs:label "in XSD Date-Time-Stamp"@en,
        "en fecha-sello de tiempo XSD"@es ;
    rdfs:comment "Position of an instant, expressed using xsd:dateTimeStamp"@en,
        "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:dateTimeStamp ;
    skos:definition "Position of an instant, expressed using xsd:dateTimeStamp"@en,
        "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es .

time:ProperInterval a owl:Class ;
    rdfs:label "Proper interval"@en,
        "intervalo propio"@es ;
    rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en,
        "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es ;
    rdfs:subClassOf time:Interval ;
    skos:definition "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en,
        "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf sulo:Object ;
    owl:disjointWith prov:InstantaneousEvent ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:t1CreateTenderDraftTask fig8:t2IncorporateInputsTask fig8:t11SendTenderForVotingTask fig8:t3SubmitTenderTask fig8:t13ReplaceSupplierTask fig8:t222MakeInputTask fig8:t12VoteForTenderTask fig8:CFT_Received fig8:Draft_Received fig8:TenderSubmitted_End fig8:SupplierReplaced_End fig8:PartnerVote_End ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:ApprovalCondition fig8:RejectionCondition ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:StartLeadDraft fig8:DraftToIncorporation fig8:IncorporationToVotingRequest fig8:ApprovalToSubmission fig8:RejectionToReplacement fig8:SubmissionToEnd fig8:ReplacementToEnd fig8:StartPartnerInput fig8:PartnerInputToVote fig8:PartnerVoteToEnd ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:LeadSupplier fig8:InvitedPartner ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:LeadSupplierRole fig8:PartnerRole ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fig8:CallForTenderVar fig8:InitialDraftVar fig8:PartnerContributionVar fig8:RevisedTenderVar fig8:PartnerDecisionVar fig8:SubmittedTenderVar fig8:DraftToPartnerMessageVar fig8:ContributionToLeadMessageVar fig8:VotingRequestMessageVar fig8:VoteToLeadMessageVar ) .

[] xsd:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

[] xsd:pattern "---(0[1-9]|[1-9][0-9])(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

[] xsd:pattern "--(0[1-9]|1[0-9]|20)(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

[] a owl:Axiom ;
    rdfs:comment "hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource prov:hadPrimarySource ;
    owl:annotatedTarget prov:wasDerivedFrom .

[] a owl:AllDisjointClasses ;
    owl:members ( sulo:Capability sulo:InformationObject sulo:Quality sulo:Role ) .

[] a owl:AllDisjointClasses ;
    owl:members ( sulo:Duration sulo:TimeInstant sulo:TimeInterval ) .

[] a owl:Axiom ;
    rdfs:comment "Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or \"quoting\", some or all of it. " ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource prov:wasQuotedFrom ;
    owl:annotatedTarget prov:wasDerivedFrom .

[] a owl:Axiom ;
    rdfs:comment """Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to 
http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'""" ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource prov:wasRevisionOf ;
    owl:annotatedTarget prov:wasDerivedFrom .

