                                            swrl:argument1 var:endA ;
                                            swrl:argument2 var:endDateA ;
                                            swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( var:startDateA var:endDateA ) ;
                                                    swrl:builtin swrlb:lessThan ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 var:b ;
                                                            swrl:argument2 var:startB ;
                                                            swrl:propertyPredicate time:hasBeginning ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 var:b ;
                                                                    swrl:argument2 var:endB ;
                                                                    swrl:propertyPredicate time:hasEnd ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 var:startB ;
                                                                            swrl:argument2 var:startDateB ;
                                                                            swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                    swrl:argument1 var:endB ;
                                                                                    swrl:argument2 var:endDateB ;
                                                                                    swrl:propertyPredicate time:inXSDDateTimeStamp ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                            swrl:arguments ( var:startDateB var:endDateB ) ;
                                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                    swrl:arguments ( var:startDateA var:startDateB ) ;
                                                                                                    swrl:builtin swrlb:lessThan ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                            swrl:arguments ( var:endDateB var:endDateA ) ;
                                                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate time:intervalContains ] ;
            rdf:rest () ] .

pm:IntervalEquals_DirectDates a swrl:Imp ;
    rdfs:label "IntervalEquals_DirectDates" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Allen interval relation: a.start = b.start and a.end = b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
