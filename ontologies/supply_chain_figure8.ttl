#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( sulo:Capability
                sulo:InformationObject
                sulo:Quality
                sulo:Role
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( sulo:Duration
                sulo:TimeInstant
                sulo:TimeInterval
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( fig8:ApprovalToSubmission
                        fig8:DraftToIncorporation
                        fig8:IncorporationToVotingRequest
                        fig8:PartnerInputToVote
                        fig8:PartnerVoteToEnd
                        fig8:RejectionToReplacement
                        fig8:ReplacementToEnd
                        fig8:StartLeadDraft
                        fig8:StartPartnerInput
                        fig8:SubmissionToEnd
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( fig8:CFT_Received
                        fig8:Draft_Received
                        fig8:PartnerVote_End
                        fig8:SupplierReplaced_End
                        fig8:TenderSubmitted_End
                        fig8:t11SendTenderForVotingTask
                        fig8:t12VoteForTenderTask
                        fig8:t13ReplaceSupplierTask
                        fig8:t1CreateTenderDraftTask
                        fig8:t222MakeInputTask
                        fig8:t2IncorporateInputsTask
                        fig8:t3SubmitTenderTask
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( fig8:CallForTenderVar
                        fig8:ContributionToLeadMessageVar
                        fig8:DraftToPartnerMessageVar
                        fig8:InitialDraftVar
                        fig8:PartnerContributionVar
                        fig8:PartnerDecisionVar
                        fig8:RevisedTenderVar
                        fig8:SubmittedTenderVar
                        fig8:VoteToLeadMessageVar
                        fig8:VotingRequestMessageVar
                      )
] .


#################################################################
#    Rules
#################################################################

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
  rdfs:comment "Allen interval relation: a.end < b.start. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
  rdfs:label "IntervalBefore_DirectDates" ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.end = b.start. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalMeets_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.start < b.start < a.end < b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalOverlaps_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.start < b.start and b.end < a.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalContains_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.start = b.start and a.end < b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalStarts_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.start = b.start and a.end = b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalEquals_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: b.start < a.start and a.end = b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalFinishes_DirectDates" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Infers a candidate producer-to-consumer dependency when explicitly distinct collaboration steps in the same plan share an output/input variable. No branch or execution-order inference is made."@en ;
   rdfs:label "SamePlan_FlowDependency" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Infers shared planned input between explicitly distinct collaboration steps in the same plan. Shared input does not by itself imply contention or an exclusive choice."@en ;
   rdfs:label "SamePlan_SharedInput" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "SWRL equivalent of the standard PROV-O property chain: qualifiedAssociation / agent implies wasAssociatedWith. Retains the lightweight PROV subset and makes qualified agent/role/plan associations usable without adding a PROV property-chain axiom."@en ;
   rdfs:label "QualifiedAssociation_Agent" ;
   rdf:type swrl:Imp ;
   swrl:body rdf:nil ;
   swrl:head rdf:nil
 ] .

