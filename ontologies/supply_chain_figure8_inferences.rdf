        <rdfs:range rdf:resource="https://www.michaeldebellis.com/supply_chain_model/DocumentSeries"/>
        <rdfs:comment xml:lang="en">Groups this particular document version into its continuing document series.</rdfs:comment>
        <rdfs:label xml:lang="en">version of</rdfs:label>
    </owl:ObjectProperty>
    


