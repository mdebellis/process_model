        <terms:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.isi.edu/~gil/</terms:creator>
        <terms:description xml:lang="en">Basic_Bro  provides core metadata annotation properties by reusing SKOS and DCTERMS. It is the foundational module used by all BRO layers and includes only annotation and datatype properties, with no classes or object properties.</terms:description>
        <terms:description xml:lang="en">PROV extension for linking Plans and parts of plans to their respective executions.</terms:description>
        <terms:isVersionOf rdf:resource="http://www.w3.org/TR/owl-time"/>
        <terms:issued>2025-07-11</terms:issued>
