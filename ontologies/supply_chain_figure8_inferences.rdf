    </owl:NamedIndividual>
    


    <!-- http://www.w3.org/2006/time#August_7_1945 -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2006/time#August_7_1945">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <sulo:contains rdf:resource="http://www.w3.org/2006/time#August_7_1945"/>
        <sulo:hasPart rdf:resource="http://www.w3.org/2006/time#August_7_1945"/>
        <sulo:isIn rdf:resource="http://www.w3.org/2006/time#August_7_1945"/>
        <sulo:isPartOf rdf:resource="http://www.w3.org/2006/time#August_7_1945"/>
        <time:inXSDDateTimeStamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">1945-08-07T00:00:00Z</time:inXSDDateTimeStamp>
    </owl:NamedIndividual>
    


    <!-- http://www.w3.org/2006/time#Battle_of_Gettysburg -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2006/time#Battle_of_Gettysburg">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <time:before rdf:resource="http://www.w3.org/2006/time#German_Invasion_of_France"/>
        <time:before rdf:resource="http://www.w3.org/2006/time#Invasion_of_Poland"/>
        <time:before rdf:resource="http://www.w3.org/2006/time#Soviet-Japanese_War_WWII"/>
        <time:before rdf:resource="http://www.w3.org/2006/time#The_Phony_War"/>
        <time:before rdf:resource="http://www.w3.org/2006/time#UK_Participation_in_WWII"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01CreateDraftInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01IncorporateInputInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01ProvideInputInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01SendAndAwaitVoteInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01SubmitInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/Run01VoteInterval"/>
        <time:before rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/TenderRun01Interval"/>
        <time:hasBeginning rdf:resource="http://www.w3.org/2006/time#July_1_1863"/>
        <time:hasEnd rdf:resource="http://www.w3.org/2006/time#July_3_1863"/>
        <time:hasTime rdf:resource="http://www.w3.org/2006/time#July_1_1863"/>
        <time:hasTime rdf:resource="http://www.w3.org/2006/time#July_3_1863"/>
        <time:intervalBefore rdf:resource="http://www.w3.org/2006/time#German_Invasion_of_France"/>
