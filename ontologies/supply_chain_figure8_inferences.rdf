    </owl:NamedIndividual>
    


    <!-- http://www.w3.org/2006/time#April_12_1861 -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2006/time#April_12_1861">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <sulo:contains rdf:resource="http://www.w3.org/2006/time#April_12_1861"/>
        <sulo:hasPart rdf:resource="http://www.w3.org/2006/time#April_12_1861"/>
        <sulo:isIn rdf:resource="http://www.w3.org/2006/time#April_12_1861"/>
        <sulo:isPartOf rdf:resource="http://www.w3.org/2006/time#April_12_1861"/>
