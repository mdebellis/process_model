    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Infers shared planned input between explicitly distinct collaboration steps in the same plan. Shared input does not by itself imply contention or an exclusive choice.</rdfs:comment>
        <rdfs:label>SamePlan_SharedInput</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/CollaborationStep"/>
                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/CollaborationStep"/>
                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:resource"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:resource"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:plan"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                                <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:plan"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom"/>
                                                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/sharesInputVariable"/>
                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Infers a candidate producer-to-consumer dependency when explicitly distinct collaboration steps in the same plan share an output/input variable. No branch or execution-order inference is made.</rdfs:comment>
        <rdfs:label>SamePlan_FlowDependency</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/CollaborationStep"/>
                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/CollaborationStep"/>
                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasOutputVar"/>
                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:resource"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:resource"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:plan"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                                <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                                <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:plan"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom"/>
                                                                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                                                                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://www.michaeldebellis.com/supply_chain_model/hasFlowDependency"/>
                        <swrl:argument1 rdf:resource="urn:supply-chain-rule:var:producer"/>
                        <swrl:argument2 rdf:resource="urn:supply-chain-rule:var:consumer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Allen interval relation: a.start = b.start and a.end = b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
        <rdfs:label>IntervalEquals_DirectDates</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#a"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#startA"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#a"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#endA"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#startA"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#startDateA"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#endA"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#endDateA"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="urn:swrl:var#startDateA"/>
                                                            <rdf:Description rdf:about="urn:swrl:var#endDateA"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                                                                <swrl:argument1 rdf:resource="urn:swrl:var#b"/>
                                                                <swrl:argument2 rdf:resource="urn:swrl:var#startB"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                                                        <swrl:argument1 rdf:resource="urn:swrl:var#b"/>
                                                                        <swrl:argument2 rdf:resource="urn:swrl:var#endB"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
