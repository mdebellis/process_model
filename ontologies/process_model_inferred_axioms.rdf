        <sulo:contains rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <sulo:hasPart rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <sulo:isIn rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <sulo:isPartOf rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
        <rdfs:label xml:lang="en">Tender Approved</rdfs:label>
        <skos:definition xml:lang="en">A completed partner vote in the selected tender execution has produced an explicit approval decision about the selected tender version.</skos:definition>
        <skos:prefLabel xml:lang="en">Tender Approved</skos:prefLabel>
    </owl:NamedIndividual>
    


