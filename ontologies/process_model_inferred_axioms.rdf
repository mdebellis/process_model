    </rdf:Description>
    <rdf:Description rdf:about="https://in2use.com/process_model/Variable_Agent">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Infers shared planned input between explicitly distinct collaboration steps in the same plan. Shared input does not by itself imply contention or an exclusive choice.</rdfs:comment>
        <rdfs:label xml:lang="en">Same Plan Shared Input</rdfs:label>
        <skos:altLabel>SamePlan_SharedInput</skos:altLabel>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://in2use.com/process_model/Collaboration_Step"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://in2use.com/process_model/Collaboration_Step"/>
                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Resource"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Resource"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Plan"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Plan"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom"/>
                                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://in2use.com/process_model/shares_input_variable"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Infers a candidate producer-to-consumer dependency when explicitly distinct collaboration steps in the same plan share an output/input variable. No branch or execution-order inference is made.</rdfs:comment>
        <rdfs:label xml:lang="en">Same Plan Flow Dependency</rdfs:label>
        <skos:altLabel>SamePlan_FlowDependency</skos:altLabel>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://in2use.com/process_model/Collaboration_Step"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://in2use.com/process_model/Collaboration_Step"/>
                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasOutputVar"/>
                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Resource"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#hasInputVar"/>
                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Resource"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Plan"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://purl.org/net/p-plan#isStepOfPlan"/>
                                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Plan"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom"/>
                                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://in2use.com/process_model/has_flow_dependency"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Producer"/>
                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Consumer"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Allen interval relation: a.start = b.start and a.end = b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
        <rdfs:label xml:lang="en">Interval Equals Direct Dates</rdfs:label>
        <skos:altLabel>IntervalEquals_DirectDates</skos:altLabel>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
