    <!-- https://in2use.com/process_model/Approved_Tender_Submission_Test -->

    <owl:NamedIndividual rdf:about="https://in2use.com/process_model/Approved_Tender_Submission_Test">
        <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdf:type rdf:resource="https://in2use.com/process_model/State_Test"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Feature"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/InformationObject"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Object"/>
        <process_model:has_evaluation_method rdf:resource="https://in2use.com/process_model/SPARQL_Evaluation"/>
        <process_model:is_state_test_of rdf:resource="https://in2use.com/process_model/Approved_Tender_Submitted"/>
        <sulo:contains rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
        <sulo:hasPart rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
        <sulo:isIn rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
        <sulo:isPartOf rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
        <process_model:has_sparql_query>PREFIX pm: &lt;https://in2use.com/process_model/&gt;
PREFIX pp: &lt;http://purl.org/net/p-plan#&gt;
PREFIX prov: &lt;http://www.w3.org/ns/prov#&gt;
PREFIX sulo: &lt;https://w3id.org/sulo/&gt;
ASK {
  ?run sulo:hasPart ?review .
  ?review pp:correspondsToStep pm:T12_Vote_For_Tender_Task ;
          prov:used ?version ;
          prov:endedAtTime ?review_end .
  ?decision a pm:Decision_Result ;
            pp:correspondsToVariable pm:Partner_Decision_Var ;
            pm:has_outcome pm:Approved ;
            pm:has_subject_version ?version ;
            prov:wasGeneratedBy ?review .
  ?run sulo:hasPart ?submission .
  ?submission pp:correspondsToStep pm:T3_Submit_Tender_Task ;
              prov:used ?version ;
              prov:endedAtTime ?submission_end .
  ?submitted_copy pp:correspondsToVariable pm:Submitted_Tender_Var ;
                  prov:wasGeneratedBy ?submission ;
                  prov:wasDerivedFrom ?version .
  ?submission prov:used ?decision .
}
</process_model:has_sparql_query>
        <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
        <rdfs:label xml:lang="en">Approved Tender Submission Test</rdfs:label>
        <skos:definition xml:lang="en">A provisional SPARQL ASK test for Approved Tender Submitted, using explicit execution and document-version bindings.</skos:definition>
        <skos:prefLabel xml:lang="en">Approved Tender Submission Test</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Required bindings: ?run is the selected tender execution IRI; ?version is the selected tender document-version IRI. No latest-version discovery is implied. Evaluate against the intended evidence dataset or snapshot. An unbound input is an evaluation error and must be rejected by the caller before execution. ASK true establishes the positive pattern in that dataset. ASK false means the pattern was not established: use Unsatisfied only when the relevant records are known complete and unambiguous for the selected run and version; otherwise use Unknown. Conflicting evidence requires assessment of the conflict and must not be silently resolved by a positive match. Runtime/query failures are Evaluation Error. These tests check recorded completed events, not workflow scheduling, vote unanimity, or absence of later revocation.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://in2use.com/process_model/Approved_Tender_Submitted -->

    <owl:NamedIndividual rdf:about="https://in2use.com/process_model/Approved_Tender_Submitted">
        <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdf:type rdf:resource="https://in2use.com/process_model/Goal"/>
        <rdf:type rdf:resource="https://in2use.com/process_model/State_Description"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Feature"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/InformationObject"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Object"/>
        <process_model:has_state_test rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
        <process_model:has_sub_goal rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <process_model:has_sub_goal rdf:resource="https://in2use.com/process_model/Tender_Submitted"/>
        <process_model:has_sub_state rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
        <process_model:has_sub_state rdf:resource="https://in2use.com/process_model/Tender_Submitted"/>
        <process_model:is_goal_of rdf:resource="https://in2use.com/process_model/Tendering_Plan"/>
        <sulo:contains rdf:resource="https://in2use.com/process_model/Approved_Tender_Submitted"/>
        <sulo:hasPart rdf:resource="https://in2use.com/process_model/Approved_Tender_Submitted"/>
        <sulo:isIn rdf:resource="https://in2use.com/process_model/Approved_Tender_Submitted"/>
        <sulo:isPartOf rdf:resource="https://in2use.com/process_model/Approved_Tender_Submitted"/>
        <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
        <rdfs:label xml:lang="en">Approved Tender Submitted</rdfs:label>
        <skos:definition xml:lang="en">In the selected tender execution, a completed submission has produced a submitted copy derived from the selected tender version, and that submission used an explicit approval decision from the same execution about that same version.</skos:definition>
        <skos:prefLabel xml:lang="en">Approved Tender Submitted</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An illustrative operational goal added to exercise state evaluation on the existing synthetic tender run. The parent query requires both component conditions for the same run and version and requires the submission to use the approval decision. Goal decomposition alone does not execute these tests.</skos:scopeNote>
    </owl:NamedIndividual>
    


