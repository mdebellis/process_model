    <!-- https://in2use.com/process_model/Review_Requirements -->

    <owl:NamedIndividual rdf:about="https://in2use.com/process_model/Review_Requirements">
        <rdf:type rdf:resource="http://purl.org/net/p-plan#Step"/>
        <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdf:type rdf:resource="https://in2use.com/process_model/Collaboration_Step"/>
        <rdf:type rdf:resource="https://in2use.com/process_model/Task_Step"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Feature"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/InformationObject"/>
        <rdf:type rdf:resource="https://w3id.org/sulo/Object"/>
        <p-plan:hasInputVar rdf:resource="https://in2use.com/process_model/Use_Cases"/>
        <p-plan:hasInputVar rdf:resource="https://in2use.com/process_model/Wireframes"/>
        <p-plan:hasOutputVar rdf:resource="https://in2use.com/process_model/Requirements_Review_Decision"/>
        <p-plan:isPrecededBy rdf:resource="https://in2use.com/process_model/Create_Detailed_Requirements"/>
        <p-plan:isPrecededBy rdf:resource="https://in2use.com/process_model/Create_Project_Narrative"/>
