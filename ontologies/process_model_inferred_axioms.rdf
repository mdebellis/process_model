    <!-- http://www.w3.org/2006/time#unitDay -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2006/time#unitDay">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#GeneralDurationDescription"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalDuration"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalUnit"/>
        <sulo:contains rdf:resource="http://www.w3.org/2006/time#unitDay"/>
        <sulo:hasPart rdf:resource="http://www.w3.org/2006/time#unitDay"/>
        <sulo:isIn rdf:resource="http://www.w3.org/2006/time#unitDay"/>
        <sulo:isPartOf rdf:resource="http://www.w3.org/2006/time#unitDay"/>
        <time:days rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</time:days>
        <time:hours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:hours>
        <time:minutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:minutes>
        <time:months rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:months>
        <time:seconds rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:seconds>
        <time:weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:weeks>
        <time:years rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:years>
        <rdfs:label xml:lang="en">Day (unit of temporal duration)</rdfs:label>
        <skos:prefLabel xml:lang="de">Tag</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">dag</skos:prefLabel>
        <skos:prefLabel xml:lang="en">day</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">dia</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">doba</skos:prefLabel>
        <skos:prefLabel xml:lang="es">día</skos:prefLabel>
        <skos:prefLabel xml:lang="it">giorno</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">jour</skos:prefLabel>
        <skos:prefLabel xml:lang="ar">يوماً ما</skos:prefLabel>
        <skos:prefLabel xml:lang="jp">ある日</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">一天</skos:prefLabel>
        <skos:prefLabel xml:lang="kr">언젠가</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://www.w3.org/2006/time#unitHour -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2006/time#unitHour">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#GeneralDurationDescription"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalDuration"/>
        <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalUnit"/>
        <sulo:contains rdf:resource="http://www.w3.org/2006/time#unitHour"/>
