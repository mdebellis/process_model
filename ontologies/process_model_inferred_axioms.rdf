                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_A"/>
                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_A"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Start_A"/>
                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_Date_A"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_End_A"/>
                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_Date_A"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_Start_Date_A"/>
                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_End_Date_A"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_B"/>
                                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_B"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_B"/>
                                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_B"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Start_B"/>
                                                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_Date_B"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_End_B"/>
                                                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_Date_B"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                                                                <swrl:arguments rdf:parseType="Collection">
                                                                                                    <rdf:Description rdf:about="https://in2use.com/process_model/Variable_Start_Date_B"/>
                                                                                                    <rdf:Description rdf:about="https://in2use.com/process_model/Variable_End_Date_B"/>
                                                                                                </swrl:arguments>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_End_Date_A"/>
                                                                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_Start_Date_B"/>
                                                                                                        </swrl:arguments>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#intervalBefore"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_A"/>
                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_B"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment xml:lang="en">Allen interval relation: a.start &lt; b.start and b.end &lt; a.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
        <rdfs:label xml:lang="en">Interval Contains Direct Dates</rdfs:label>
        <skos:altLabel>IntervalContains_DirectDates</skos:altLabel>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_A"/>
                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_A"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_A"/>
                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_A"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_Start_A"/>
                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_Date_A"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_End_A"/>
                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_Date_A"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_Start_Date_A"/>
                                                            <rdf:Description rdf:about="https://in2use.com/process_model/Variable_End_Date_A"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                                                                <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_B"/>
                                                                <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_Start_B"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                                                        <swrl:argument1 rdf:resource="https://in2use.com/process_model/Variable_B"/>
                                                                        <swrl:argument2 rdf:resource="https://in2use.com/process_model/Variable_End_B"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
