        <sulo:hasPart rdf:resource="http://purl.org/net/p-plan#"/>
        <sulo:isIn rdf:resource="http://purl.org/net/p-plan#"/>
        <sulo:isPartOf rdf:resource="http://purl.org/net/p-plan#"/>
    </owl:Thing>
    


