                                         rdfs:range <http://www.w3.org/2006/time#GeneralDateTimeDescription> ;
                                         rdfs:comment "Posición de un instante, expresada utilizando una descripción estructurada."@es ,
                                                      "Position of an instant, expressed using a structured description"@en ;
                                         rdfs:label "en descripción de fecha-hora"@es ,
                                                    "in date-time description"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Posición de un instante, expresada utilizando una descripción estructurada."@es ,
                                                                                          "Position of an instant, expressed using a structured description"@en .


###  http://www.w3.org/2006/time#inTemporalPosition
<http://www.w3.org/2006/time#inTemporalPosition> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.w3.org/2006/time#Instant> ;
                                                 rdfs:range <http://www.w3.org/2006/time#TemporalPosition> ;
                                                 rdfs:comment "Posición de un instante de tiempo."@es ,
                                                              "Position of a time instant"@en ;
                                                 rdfs:label "Temporal position"@en ,
                                                            "posición temporal"@es ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Posición de un instante de tiempo."@es ,
                                                                                                  "Position of a time instant"@en .


###  http://www.w3.org/2006/time#inTimePosition
<http://www.w3.org/2006/time#inTimePosition> rdf:type owl:ObjectProperty ;
