 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Allen interval relation: a.start < b.start and b.end < a.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
   rdfs:label "IntervalContains_DirectDates" ;
