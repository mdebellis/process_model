[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
  rdfs:comment "Allen interval relation: a.end < b.start. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start < end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms."@en ;
  rdfs:label "IntervalBefore_DirectDates" ;
  rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
  <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
  <http://www.w3.org/2003/11/swrl#head> rdf:nil
] .

