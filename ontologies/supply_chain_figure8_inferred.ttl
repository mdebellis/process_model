[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/sulo/Capability>
                <https://w3id.org/sulo/InformationObject>
                <https://w3id.org/sulo/Quality>
                <https://w3id.org/sulo/Role>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/sulo/Duration>
                <https://w3id.org/sulo/TimeInstant>
                <https://w3id.org/sulo/TimeInterval>
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( <https://www.michaeldebellis.com/supply_chain_figure8/ApprovalToSubmission>
                        <https://www.michaeldebellis.com/supply_chain_figure8/DraftToIncorporation>
                        <https://www.michaeldebellis.com/supply_chain_figure8/IncorporationToVotingRequest>
                        <https://www.michaeldebellis.com/supply_chain_figure8/PartnerInputToVote>
                        <https://www.michaeldebellis.com/supply_chain_figure8/PartnerVoteToEnd>
                        <https://www.michaeldebellis.com/supply_chain_figure8/RejectionToReplacement>
                        <https://www.michaeldebellis.com/supply_chain_figure8/ReplacementToEnd>
                        <https://www.michaeldebellis.com/supply_chain_figure8/StartLeadDraft>
                        <https://www.michaeldebellis.com/supply_chain_figure8/StartPartnerInput>
                        <https://www.michaeldebellis.com/supply_chain_figure8/SubmissionToEnd>
                      )
