  </rdf:Description>
  <rdf:Description rdf:nodeID="Naeb293b297904f43aed9c7518000914c">
    <rdf:rest rdf:nodeID="N2b78f9c1a774459c811fef8a82dcde24"/>
    <rdf:first rdf:resource="https://in2use.com/process_model/Partner_Vote_End"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://in2use.com/process_model/has_expected_duration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has expected duration</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
    <rdfs:label xml:lang="en">has expected duration</rdfs:label>
    <rdfs:domain rdf:nodeID="Nec38a628a87546f781ef32f19645c358"/>
    <rdfs:comment xml:lang="en">An estimate of the elapsed duration of an execution described by a Plan or Step, represented as an OWL-Time Duration with a numeric value and unit. It is not actual elapsed time, labor effort, or an implicit working-calendar calculation. State separately whether a composite estimate includes rework. No default inheritance or roll-up arithmetic is implied.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Duration"/>
    <skos:altLabel xml:lang="en">expected duration</skos:altLabel>
  </rdf:Description>
