    <rdf:type rdf:resource="http://purl.org/net/p-plan#Variable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Use Cases</rdfs:label>
