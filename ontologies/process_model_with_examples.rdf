  <rdf:Description rdf:about="http://www.w3.org/ns/prov#EntityInfluence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Influence"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <rdfs:label>EntityInfluence</rdfs:label>
    <rdfs:comment xml:lang="en">It is not recommended that the type EntityInfluence be asserted without also asserting one of its more specific subclasses.</rdfs:comment>
    <rdfs:comment xml:lang="en">EntityInfluence provides additional descriptions of an Entity's binary influence upon any other kind of resource. Instances of EntityInfluence use the prov:entity property to cite the influencing Entity.</rdfs:comment>
    </rdf:Description>
  <rdf:Description rdf:about="https://in2use.com/process_model/Tender_Approval_Test">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://in2use.com/process_model/State_Test"/>
    <skos:prefLabel xml:lang="en">Tender Approval Test</skos:prefLabel>
    <pm:has_evaluation_method rdf:resource="https://in2use.com/process_model/SPARQL_Evaluation"/>
    <skos:definition xml:lang="en">A provisional SPARQL ASK test for Tender Approved, using explicit execution and document-version bindings.</skos:definition>
    <rdfs:label xml:lang="en">Tender Approval Test</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
    <skos:scopeNote xml:lang="en">Required bindings: ?run is the selected tender execution IRI; ?version is the selected tender document-version IRI. No latest-version discovery is implied. Evaluate against the intended evidence dataset or snapshot. An unbound input is an evaluation error and must be rejected by the caller before execution. ASK true establishes the positive pattern in that dataset. ASK false means the pattern was not established: use Unsatisfied only when the relevant records are known complete and unambiguous for the selected run and version; otherwise use Unknown. Conflicting evidence requires assessment of the conflict and must not be silently resolved by a positive match. Runtime/query failures are Evaluation Error. These tests check recorded completed events, not workflow scheduling, vote unanimity, or absence of later revocation.</skos:scopeNote>
    <pm:has_sparql_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PREFIX pm: &lt;https://in2use.com/process_model/&gt;
PREFIX pp: &lt;http://purl.org/net/p-plan#&gt;
PREFIX prov: &lt;http://www.w3.org/ns/prov#&gt;
PREFIX sulo: &lt;https://w3id.org/sulo/&gt;
ASK {
  ?run sulo:hasPart ?review .
  ?review pp:correspondsToStep pm:T12_Vote_For_Tender_Task ;
          prov:used ?version ;
          prov:endedAtTime ?review_end .
  ?decision a pm:Decision_Result ;
            pp:correspondsToVariable pm:Partner_Decision_Var ;
            pm:has_outcome pm:Approved ;
            pm:has_subject_version ?version ;
            prov:wasGeneratedBy ?review .
}
</pm:has_sparql_query>
  </rdf:Description>
