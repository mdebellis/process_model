  <rdf:Description rdf:about="http://www.w3.org/ns/prov#specializationOf">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization</prov:dm>
    <prov:definition xml:lang="en">An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity.</prov:definition>
    <rdfs:label>specializationOf</rdfs:label>
    <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig</prov:constraints>
    <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization</prov:n>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#alternateOf"/>
    <prov:category>expanded</prov:category>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#alternateOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <prov:component>alternate</prov:component>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <prov:inverse>generalizationOf</prov:inverse>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/process_model/has_evaluation_method">
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <rdfs:domain rdf:resource="https://www.in2use.com/process_model/State_Test"/>
    <owl:inverseOf rdf:resource="https://www.in2use.com/process_model/is_evaluation_method_of"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has evaluation method</skos:prefLabel>
    <rdfs:label xml:lang="en">has evaluation method</rdfs:label>
    <rdfs:range rdf:resource="https://www.in2use.com/process_model/Evaluation_Method"/>
    <skos:definition xml:lang="en">Relates a test specification to the approach that determines its result. Calling an LLM through SPARQL remains an LLM assessment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/process_model/has_sparql_query">
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <rdfs:domain rdf:resource="https://www.in2use.com/process_model/State_Test"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The complete SPARQL query text for a test. Deterministic examples use ASK; the ChatGPT example uses SELECT and an AllegroGraph extension function. This representation is provisional and does not constrain future higher-level expressions.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel xml:lang="en">has sparql query</skos:prefLabel>
    <rdfs:label xml:lang="en">has sparql query</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_figure8/t13ReplaceSupplierTask">
