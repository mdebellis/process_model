  <rdf:Description rdf:about="https://in2use.com/process_model/Interval_Before_Direct_Dates">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <swrl:head rdf:nodeID="N4b299cdb5a6d4faea8b0a75a0daf8e21"/>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdfs:comment xml:lang="en">Allen interval relation: a.end &lt; b.start. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
    <rdfs:label xml:lang="en">Interval Before Direct Dates</rdfs:label>
    <swrl:body rdf:nodeID="N9eada64a64b1462986496ccff6714eb3"/>
    <skos:altLabel>IntervalBefore_DirectDates</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#MonthOfYear">
