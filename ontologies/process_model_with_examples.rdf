    <rdfs:range rdf:resource="https://www.in2use.com/process_model/State_Evaluation"/>
    <skos:definition xml:lang="en">Relates a state description to a record of one assessment of it. Assessments for different executions, versions, evidence snapshots or times are separate records.</skos:definition>
