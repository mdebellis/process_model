  <rdf:Description rdf:about="http://www.w3.org/2006/time#TimePosition">
    <rdfs:label xml:lang="es">posición de tiempo</rdfs:label>
    <rdfs:label xml:lang="en">Time position</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N21ceeb6915f04e8f9ecec5c9d53a31c9"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalPosition"/>
    <rdfs:comment xml:lang="es">Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales.</rdfs:comment>
    <rdfs:comment xml:lang="en">A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. </rdfs:comment>
