  <rdf:Description rdf:about="https://in2use.com/process_model/PartnerInputToVote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://in2use.com/process_model/StepTransition"/>
    <pm:transitionTo rdf:resource="https://in2use.com/process_model/t12VoteForTenderTask"/>
    <rdfs:label xml:lang="en">t222MakeInputTask to t12VoteForTenderTask</rdfs:label>
