  <rdf:Description rdf:about="https://in2use.com/process_model/IntervalOverlaps_DirectDates">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:comment xml:lang="en">Allen interval relation: a.start &lt; b.start &lt; a.end &lt; b.end. Compares time:inXSDDateTimeStamp values directly; both intervals must have beginning/end timestamps with start &lt; end. Equal timestamps may belong to distinct instant individuals. No instant-to-instant ordering is materialized. Inverse relations are supplied by the retained OWL-Time inverse-property axioms.</rdfs:comment>
    <rdfs:label>IntervalOverlaps_DirectDates</rdfs:label>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <swrl:body rdf:nodeID="Nac440b02652e400989597690f83104d9"/>
    <swrl:head rdf:nodeID="N4edb6797aaba408791f33818ba2b0693"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Usage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An instance of prov:Usage provides additional descriptions about the binary prov:used relation from some prov:Activity to an prov:Entity that it used. For example, :keynote prov:used :podium; prov:qualifiedUsage [ a prov:Usage; prov:entity :podium; :foo :bar ].</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#EntityInfluence"/>
    <rdfs:label>Usage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8f043b59fab5462f95c2156e07ef829a">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://in2use.com/process_model/Variable_End_Date_B"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#TemporalPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:nodeID="Na0645c5943e646338860ac58c447634b"/>
    <skos:definition xml:lang="en">A position on a time-line</skos:definition>
    <skos:definition xml:lang="es">Una posición sobre una línea de tiempo.</skos:definition>
    <rdfs:comment xml:lang="es">Una posición sobre una línea de tiempo.</rdfs:comment>
