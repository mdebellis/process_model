    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:comment xml:lang="en">has item is a relation between an item and the collection in which it contained.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/sulo/Collection"/>
  </rdf:Description>
