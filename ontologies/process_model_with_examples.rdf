    <skos:prefLabel xml:lang="en">has exposed output variable</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
    <skos:altLabel xml:lang="en">exposes output variable</skos:altLabel>
