    <rdfs:comment xml:lang="en">Entry point for the example. The lead supplier and invited partner participate in one collaboration plan with separate role assignments and event lanes.</rdfs:comment>
    <rdfs:label xml:lang="en">Figure 8 collaborative tendering plan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/CollaborationPlan"/>
    <dcterms:source rdf:resource="https://doi.org/10.1080/00207543.2023.2242508"/>
