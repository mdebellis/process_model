  <rdf:Description rdf:about="https://in2use.com/process_model/Planned_Assignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An intended agent/role assignment for a planned step. Use has_assigned_step, has_assigned_agent and assignedRole. This is not a PROV Association and creates no actual wasAssociatedWith assertion.</rdfs:comment>
