    <skos:prefLabel xml:lang="en">Spatial Object</skos:prefLabel>
    <skos:example xml:lang="en">a mountain, a planet, a photon, the lining of the stomach, the cavity of the stomach, the space between mars and earth</skos:example>
  </rdf:Description>
