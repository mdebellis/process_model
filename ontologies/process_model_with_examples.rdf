    <prov:definition xml:lang="en">p-plan:hasOutputVar binds a p-plan:Step to the p-plan:Variable that will be produced as output in the planned execution</prov:definition>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/net/p-plan#"/>
    <rdfs:range rdf:resource="http://purl.org/net/p-plan#Variable"/>
    <rdfs:domain rdf:resource="http://purl.org/net/p-plan#Step"/>
    </rdf:Description>
  <rdf:Description rdf:about="https://in2use.com/process_model/has_evaluated_entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
    <skos:definition xml:lang="en">Relates an evaluation record to an entity, such as the selected document version, bound as an input to the test. The test input contract specifies the role of each input.</skos:definition>
