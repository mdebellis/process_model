    <rdfs:label xml:lang="en">State Test</rdfs:label>
    <skos:definition xml:lang="en">An information object specifying how to assess a state description for explicitly supplied inputs and evidence. SPARQL is the provisional executable representation; an LLM invocation is an assessment procedure, not a formal logical definition.</skos:definition>
  </rdf:Description>
