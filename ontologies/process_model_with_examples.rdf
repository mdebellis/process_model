    <rdfs:label xml:lang="en">Partner approves submission</rdfs:label>
    <owl:differentFrom rdf:resource="https://www.michaeldebellis.com/supply_chain_figure8/RejectionCondition"/>
    <sc:expectedOutcome rdf:resource="https://www.michaeldebellis.com/supply_chain_model/Approved"/>
    <skos:definition xml:lang="en">The decision artifact corresponding to the Partner Decision variable for the selected tender execution and review round has the explicit Approved outcome. The decision must concern the document version selected for evaluation.</skos:definition>
  </rdf:Description>
