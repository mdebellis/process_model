  <rdf:Description rdf:about="https://www.in2use.com/process_model/Tender_Submission_Test">
    <pm:has_sparql_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PREFIX fig: &lt;https://www.michaeldebellis.com/supply_chain_figure8/&gt;
PREFIX sc: &lt;https://www.michaeldebellis.com/supply_chain_model/&gt;
PREFIX pp: &lt;http://purl.org/net/p-plan#&gt;
PREFIX prov: &lt;http://www.w3.org/ns/prov#&gt;
PREFIX sulo: &lt;https://w3id.org/sulo/&gt;
ASK {
  ?run sulo:hasPart ?submission .
  ?submission pp:correspondsToStep fig:t3SubmitTenderTask ;
              prov:used ?version ;
              prov:endedAtTime ?submission_end .
  ?submitted_copy pp:correspondsToVariable fig:SubmittedTenderVar ;
                  prov:wasGeneratedBy ?submission ;
                  prov:wasDerivedFrom ?version .
}
</pm:has_sparql_query>
    <skos:scopeNote xml:lang="en">Required bindings: ?run is the selected tender execution IRI; ?version is the selected tender document-version IRI. No latest-version discovery is implied. Evaluate against the intended evidence dataset or snapshot. An unbound input is an evaluation error and must be rejected by the caller before execution. ASK true establishes the positive pattern in that dataset. ASK false means the pattern was not established: use Unsatisfied only when the relevant records are known complete and unambiguous for the selected run and version; otherwise use Unknown. Conflicting evidence requires assessment of the conflict and must not be silently resolved by a positive match. Runtime/query failures are Evaluation Error. These tests check recorded completed events, not workflow scheduling, vote unanimity, or absence of later revocation.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <skos:definition xml:lang="en">A provisional SPARQL ASK test for Tender Submitted, using explicit execution and document-version bindings.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Submission Test</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.in2use.com/process_model/State_Test"/>
    <rdfs:label xml:lang="en">Tender Submission Test</rdfs:label>
    <pm:has_evaluation_method rdf:resource="https://www.in2use.com/process_model/SPARQL_Evaluation"/>
  </rdf:Description>
