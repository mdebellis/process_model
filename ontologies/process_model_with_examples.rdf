  <rdf:Description rdf:about="https://in2use.com/process_model/Approved_Tender_Submitted">
    <rdf:type rdf:resource="https://in2use.com/process_model/Goal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model"/>
    <rdfs:label xml:lang="en">Approved Tender Submitted</rdfs:label>
    <skos:scopeNote xml:lang="en">An illustrative operational goal added to exercise state evaluation on the existing synthetic tender run. The parent query requires both component conditions for the same run and version and requires the submission to use the approval decision. Goal decomposition alone does not execute these tests.</skos:scopeNote>
    <pm:has_sub_goal rdf:resource="https://in2use.com/process_model/Tender_Submitted"/>
    <pm:has_sub_goal rdf:resource="https://in2use.com/process_model/Tender_Approved"/>
    <skos:definition xml:lang="en">In the selected tender execution, a completed submission has produced a submitted copy derived from the selected tender version, and that submission used an explicit approval decision from the same execution about that same version.</skos:definition>
    <pm:has_state_test rdf:resource="https://in2use.com/process_model/Approved_Tender_Submission_Test"/>
    <skos:prefLabel xml:lang="en">Approved Tender Submitted</skos:prefLabel>
  </rdf:Description>
