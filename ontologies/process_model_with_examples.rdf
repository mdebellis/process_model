  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/process_model/State_Test">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/InformationObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">State Test</skos:prefLabel>
    <rdfs:label xml:lang="en">State Test</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <skos:definition xml:lang="en">An information object specifying how to assess a state description for explicitly supplied inputs and evidence. SPARQL is the provisional executable representation; an LLM invocation is an assessment procedure, not a formal logical definition.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#endedAtTime">
    <rdfs:comment xml:lang="en">The time at which an activity ended. See also prov:startedAtTime.</rdfs:comment>
    <prov:component>entities-activities</prov:component>
    <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#atTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:category>starting-point</prov:category>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <prov:editorialNote xml:lang="en">It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime.</prov:editorialNote>
    <rdfs:label>endedAtTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
