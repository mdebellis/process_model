    <rdfs:subClassOf rdf:nodeID="N0af3c4e94cdb4c10aed73cfc2ec37c65"/>
    <rdfs:subClassOf rdf:nodeID="N6031ec31c6cd461a84626d2867730806"/>
    <rdfs:comment xml:lang="es">Descripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj.</rdfs:comment>
    <rdfs:comment xml:lang="en">Description of date and time structured with separate values for the various elements of a calendar-clock system</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>enDescripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj.</skos:definition>
