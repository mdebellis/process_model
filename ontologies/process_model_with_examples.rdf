  <rdf:Description rdf:about="https://in2use.com/process_model/has_sub_goal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://in2use.com/process_model/Goal"/>
    <rdfs:isDefinedBy rdf:resource="https://in2use.com/process_model/"/>
    <rdfs:subPropertyOf rdf:resource="https://in2use.com/process_model/has_sub_state"/>
    <rdfs:range rdf:resource="https://in2use.com/process_model/Goal"/>
    <rdfs:label xml:lang="en">has sub goal</rdfs:label>
    <skos:definition xml:lang="en">Relates a goal to a component goal in its decomposition. The parent test specifies how its subgoals contribute to satisfaction.</skos:definition>
    <owl:inverseOf rdf:resource="https://in2use.com/process_model/is_sub_goal_of"/>
    <skos:prefLabel xml:lang="en">has sub goal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://in2use.com/process_model/mergedSourceMetadata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:versionInfo xml:lang="en">Recommendation version 2013-04-30, subsetted as PROV-Lite for Big Bro</owl:versionInfo>
    <owl:versionInfo>1.2</owl:versionInfo>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionInfo>0.2.14</owl:versionInfo>
    <dcterms:alternative xml:lang="en">SULO</dcterms:alternative>
    <dcterms:isVersionOf rdf:resource="http://www.w3.org/TR/owl-time"/>
    <dcterms:title xml:lang="en">The P-Plan ontology</dcterms:title>
    <dcterms:title xml:lang="en">Simplified Upper Level Ontology</dcterms:title>
    <dcterms:title xml:lang="en">Basic Reusable Ontology 1 big_bro</dcterms:title>
    <skos:editorialNote xml:lang="en">Basic_Bro includes the legacy Dublin Core (dc:) namespace only because it is automatically imported by DCTERMS for backward compatibility. BRO users should always use dcterms:* properties and never use dc:* properties.</skos:editorialNote>
    <owl:priorVersion rdf:resource="https://w3id.org/sulo/sulo-0.2.3.ttl"/>
    <owl:priorVersion rdf:resource="http://www.w3.org/2006/time#2006"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-09-27</dcterms:created>
    <dcterms:created>2025-11-28</dcterms:created>
    <dcterms:created>2024-11-11</dcterms:created>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-11-10</dcterms:created>
    <skos:changeNote>2017-02 - intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration</skos:changeNote>
    <skos:changeNote xml:lang="en">2025-11-29 (M. DeBellis): Created PROV-Lite as a cleaned subset of the W3C PROV-O Turtle serialization for use with the Basic Reusable Ontology (Big Bro).
– Removed duplicate owl:Ontology declarations.
– Moved orphaned ontology metadata triples (label, seeAlso, versionIRI, versionInfo, specializationOf, wasRevisionOf) under this ontology IRI.
– Removed stray non-comment prose that appeared after the :wasStartedBy axiom and caused Turtle parse errors.
– Trimmed PROV terms and axioms not required by Big Bro, without changing the IRIs or logical meaning of the retained PROV terms.</skos:changeNote>
    <skos:changeNote xml:lang="en">Imported W3C Time with SWRL Rules for Allen Interval Algebra from: https://raw.githubusercontent.com/mdebellis/Time-Ontology-With-SWRL-Rules/refs/heads/main/W3C%20Time%20With%20SWRL%20Rules%20V2.ttl  

Merged Time into Bro_Pro and renamed to process_model

MD 10-22-2026</skos:changeNote>
    <skos:changeNote>2016-12-20 - restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked "deprecated". </skos:changeNote>
    <skos:changeNote xml:lang="en">Merged owl:imports &lt;http://purl.org/net/p-plan#&gt; MD 10/8/2026</skos:changeNote>
    <skos:changeNote>2017-04-06 - hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal</skos:changeNote>
    <skos:changeNote xml:lang="en">Imported P-Plan Ontology: https://www.opmw.org/model/p-plan/
Source file: https://www.opmw.org/p-plan.owl
Licensed under Creative Commons Attribution-NonCommercial-ShareAlike 2.0 Generic License at: http://creativecommons.org/licenses/by-nc-sa/2.0/
MD 10/8/2026</skos:changeNote>
    <skos:changeNote>2016-06-15 - initial update of OWL-Time - modified to support arbitrary temporal reference systems. </skos:changeNote>
    <skos:changeNote>Imported SULO upper model: https://w3id.org/sulo/
December 17, 2025
Michael DeBellis</skos:changeNote>
    <skos:changeNote>2016-12-20 - adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.  </skos:changeNote>
    <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.3233/SW-150187"/>
    <rdfs:seeAlso rdf:resource="http://www.semantic-web-journal.net/content/time-ontology-extended-non-gregorian-calendar-applications"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/owl-time"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/prov-o/"/>
    <vann:preferredNamespacePrefix>sulo</vann:preferredNamespacePrefix>
    <vann:preferredNamespacePrefix>p-plan</vann:preferredNamespacePrefix>
    <owl:backwardCompatibleWith rdf:resource="https://w3id.org/sulo/sulo-0.2.3.ttl"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8269-8171"/>
    <dcterms:contributor rdf:resource="mailto:chris.little@metoffice.gov.uk"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-7222-3287"/>
    <dcterms:contributor xml:lang="en">Michael DeBellis Orcid ID: 0000-0002-8824-9577</dcterms:contributor>
    <rdfs:comment>PROV extension for linking Plans and parts of plans to their respective executions. Created by Daniel Garijo and Yolanda Gil</rdfs:comment>
    <rdfs:comment xml:lang="en">Historical metadata copied unchanged from the uploaded merged ontology header. This record retains upstream attribution, license statements, version notes and merge history; it is not a declaration of interchangeable licenses for the combined ontology.</rdfs:comment>
    <rdfs:comment xml:lang="en">Subset of the W3C PROV-O ontology containing only the terms needed by the Basic Reusable Ontology (Big Bro). IRIs of PROV terms are preserved; content not required by Big Bro has been omitted.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Simplified Upper Level Ontology (SULO) is ontology with a minimal set of classes and relations to guide the development of a personal health knowledge graph.</rdfs:comment>
    <ns2:authoredBy rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
    <ns1:hasRepresentationLanguage rdf:resource="http://omv.ontoware.org/2005/05/ontology#OWL"/>
    <dcterms:creator rdf:resource="mailto:panfeng66@gmail.com"/>
    <dcterms:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.isi.edu/~gil/</dcterms:creator>
    <dcterms:creator rdf:resource="http://orcid.org/0000-0002-3884-3420"/>
    <dcterms:creator rdf:resource="https://en.wikipedia.org/wiki/Jerry_Hobbs"/>
    <dcterms:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://delicias.dia.fi.upm.es/members/DGarijo#me</dcterms:creator>
    <schema:includedInDataCatalog rdf:resource="https://lov.linkeddata.es/dataset/lov/vocabs/sulo"/>
    <foaf:homepage rdf:resource="https://github.com/AIDAVA-DEV/sulo"/>
    <rdfs:label xml:lang="es">Tiempo en OWL</rdfs:label>
    <rdfs:label xml:lang="en">OWL-Time</rdfs:label>
    <rdfs:label xml:lang="en">Bro Pro</rdfs:label>
    <ns1:status>active</ns1:status>
    <dcterms:language rdf:resource="http://lexvo.org/id/iso639-1/en"/>
    <dcterms:description xml:lang="en">Basic_Bro  provides core metadata annotation properties by reusing SKOS and DCTERMS. It is the foundational module used by all BRO layers and includes only annotation and datatype properties, with no classes or object properties.</dcterms:description>
    <dcterms:description xml:lang="en">PROV extension for linking Plans and parts of plans to their respective executions.</dcterms:description>
    <dcterms:publisher rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
    <dc:creator rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
    <dcterms:bibliographicCitation xml:lang="en">Michel Dumontier, Remzi Çelebi, Komal Gilani, Isabelle de Zegher, Katerina Serafimova, Catalina Martínez Costa and Stefan Schulz. SULO - a simplified upper-level ontology. Proceedings of the Joint Ontology Workshops (JOWO) - Episode XI: The Sicilian Summer under the Etna, co-located with the 15th International Conference on Formal Ontology in Information Systems (FOIS 2025), September 8-9, 2025, Catania, Italy</dcterms:bibliographicCitation>
    <schema:funding xml:lang="en">This work is partially supported by the AIDAVA project (GA 101057062), as part of the European Union's Horizon Europe research and innovation programme.</schema:funding>
    <dcterms:rights xml:lang="en">Copyright © 2006-2017 W3C, OGC. W3C and OGC liability, trademark and document use rules apply.</dcterms:rights>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-04-06</dcterms:modified>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-05-17</dcterms:modified>
    <dcterms:modified>2026-05-19</dcterms:modified>
    <skos:note xml:lang="en">Basic_Bro reuses annotation and datatype properties from the SKOS and DCTERMS vocabularies. All classes and object properties from imported vocabularies have been removed to provide a clean metadata-only reusable layer.</skos:note>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
    <dcterms:license>http://creativecommons.org/licenses/by-nc-sa/2.0/</dcterms:license>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0"/>
    <skos:historyNote xml:lang="en">Update of OWL-Time ontology, extended to support general temporal reference systems. 

Ontology engineering by Simon J D Cox</skos:historyNote>
    <skos:historyNote>2023-09-12  Added SWRL rules and some test cases to implement the logic of the various operators. 

Michael DeBellis mdebellissf@gmail.com</skos:historyNote>
