  <rdf:Description rdf:about="https://www.michaeldebellis.com/supply_chain_figure8/ApprovalCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/DecisionCondition"/>
