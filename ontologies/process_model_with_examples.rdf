    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Association"/>
    <skos:prefLabel xml:lang="en">qualified association</skos:prefLabel>
    <dcterms:description>A relation from an activity to an association qualifying the involvement of an agent in the activity.</dcterms:description>
