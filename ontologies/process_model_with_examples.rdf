  <rdf:Description rdf:about="http://www.w3.org/ns/prov#InstantaneousEvent">
    <rdfs:label>InstantaneousEvent</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <skos:prefLabel xml:lang="en">Instantaneous Event</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/Process"/>
    <prov:category>qualified</prov:category>
    <prov:definition xml:lang="en">The PROV data model is implicitly based on a notion of instantaneous events (or just events), that mark transitions in the world. Events include generation, usage, or invalidation of entities, as well as starting or ending of activities. This notion of event is not first-class in the data model, but it is useful for explaining its other concepts and its semantics.</prov:definition>
    <rdfs:comment xml:lang="en">An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous.</rdfs:comment>
    <prov:component>entities-activities</prov:component>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#dfn-event</prov:constraints>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/method_omega/Use_Case_Interviews_To_Write_Use_Cases">
    <rdfs:label xml:lang="en">Use Case Interviews To Write Use Cases</rdfs:label>
    <skos:prefLabel xml:lang="en">Use Case Interviews To Write Use Cases</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.in2use.com/process_model/Finish_To_Start_Transition"/>
    <rdf:type rdf:resource="https://www.michaeldebellis.com/supply_chain_model/StepTransition"/>
    <sc:transitionTo rdf:resource="https://www.in2use.com/method_omega/Write_Use_Cases"/>
    <sc:transitionFrom rdf:resource="https://www.in2use.com/method_omega/Use_Case_Interviews"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.in2use.com/process_model/Tender_Approval_Test">
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <pm:has_evaluation_method rdf:resource="https://www.in2use.com/process_model/SPARQL_Evaluation"/>
    <skos:scopeNote xml:lang="en">Required bindings: ?run is the selected tender execution IRI; ?version is the selected tender document-version IRI. No latest-version discovery is implied. Evaluate against the intended evidence dataset or snapshot. An unbound input is an evaluation error and must be rejected by the caller before execution. ASK true establishes the positive pattern in that dataset. ASK false means the pattern was not established: use Unsatisfied only when the relevant records are known complete and unambiguous for the selected run and version; otherwise use Unknown. Conflicting evidence requires assessment of the conflict and must not be silently resolved by a positive match. Runtime/query failures are Evaluation Error. These tests check recorded completed events, not workflow scheduling, vote unanimity, or absence of later revocation.</skos:scopeNote>
    <skos:prefLabel xml:lang="en">Tender Approval Test</skos:prefLabel>
    <rdfs:label xml:lang="en">Tender Approval Test</rdfs:label>
    <skos:definition xml:lang="en">A provisional SPARQL ASK test for Tender Approved, using explicit execution and document-version bindings.</skos:definition>
    <rdf:type rdf:resource="https://www.in2use.com/process_model/State_Test"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <pm:has_sparql_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PREFIX fig: &lt;https://www.michaeldebellis.com/supply_chain_figure8/&gt;
PREFIX sc: &lt;https://www.michaeldebellis.com/supply_chain_model/&gt;
PREFIX pp: &lt;http://purl.org/net/p-plan#&gt;
PREFIX prov: &lt;http://www.w3.org/ns/prov#&gt;
PREFIX sulo: &lt;https://w3id.org/sulo/&gt;
ASK {
  ?run sulo:hasPart ?review .
  ?review pp:correspondsToStep fig:t12VoteForTenderTask ;
          prov:used ?version ;
          prov:endedAtTime ?review_end .
  ?decision a sc:DecisionResult ;
            pp:correspondsToVariable fig:PartnerDecisionVar ;
            sc:hasOutcome sc:Approved ;
            sc:aboutVersion ?version ;
            prov:wasGeneratedBy ?review .
}
</pm:has_sparql_query>
