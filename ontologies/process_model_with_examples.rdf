  <rdf:Description rdf:about="https://www.michaeldebellis.com/process_model/mergedSourceMetadata">
    <dcterms:publisher rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
    <dcterms:modified>2026-05-19</dcterms:modified>
