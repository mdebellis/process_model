  <rdf:Description rdf:about="https://www.in2use.com/process_model/has_state_test">
    <rdfs:range rdf:resource="https://www.in2use.com/process_model/State_Test"/>
    <rdfs:isDefinedBy rdf:resource="https://www.in2use.com/process_model/"/>
    <rdfs:domain rdf:resource="https://www.in2use.com/process_model/State_Description"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://www.in2use.com/process_model/is_state_test_of"/>
    <skos:definition xml:lang="en">Relates a state description to a test specification that can assess it. Multiple tests are alternatives whose selection is explicit; they are not automatically combined or tried in sequence.</skos:definition>
    <skos:prefLabel xml:lang="en">has state test</skos:prefLabel>
    <rdfs:label xml:lang="en">has state test</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasTime">
    <skos:editorialNote xml:lang="es">Característica arriesgada -añadida en la revisión del 2017 que no ha sido todavía utilizada de forma amplia.</skos:editorialNote>
    <skos:editorialNote xml:lang="en">Feature at risk - added in 2017 revision, and not yet widely used. </skos:editorialNote>
    <rdfs:label xml:lang="es">tiene tiempo</rdfs:label>
