# Requires materialized hasPart inferences visible to the query engine.
# Display only existing direct parent/child triples, including the root's edges.
# The root is selected explicitly because hasPart is not globally reflexive.
PREFIX pm: <https://in2use.com/process_model/>
PREFIX sulo: <https://w3id.org/sulo/>

SELECT DISTINCT ?subject ?predicate ?object
WHERE {
  {
    { VALUES ?subject { pm:Customer_Portal_Execution } }
    UNION
    { pm:Customer_Portal_Execution sulo:hasPart ?subject . }
  }
  VALUES ?predicate { sulo:hasDirectPart }
  ?subject ?predicate ?object .
}
ORDER BY ?subject ?object
