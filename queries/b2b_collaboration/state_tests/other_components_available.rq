# Runnable example at the snapshot cutoff; change as_of to inspect an earlier event time.
PREFIX pm: <https://in2use.com/process_model/>
PREFIX pp: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sulo: <https://w3id.org/sulo/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  VALUES (?run ?as_of) { (pm:Lavatory_Collaboration_Execution "2027-03-04T12:00:00Z"^^xsd:dateTime) }
?run prov:qualifiedAssociation ?run_association .
?run_association prov:hadPlan pm:Lavatory_Collaboration_Plan .
pm:Lavatory_Other_Components_Receipt_01 a pm:Resource_Receipt ; pm:has_received_resource pm:Lavatory_Other_Components_01 ; pm:has_receiving_agent pm:Turbo_Co ; prov:generatedAtTime ?other_receipt_time .
pm:Lavatory_Other_Components_01 pp:correspondsToVariable pm:Lavatory_Other_Components_Var ; prov:generatedAtTime ?other_components_time .
FILTER(xsd:dateTime(STR(?other_receipt_time)) <= xsd:dateTime(STR(?as_of)))
FILTER(xsd:dateTime(STR(?other_components_time)) <= xsd:dateTime(STR(?as_of)))
}
