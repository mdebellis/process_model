PREFIX pm: <https://in2use.com/process_model/>
PREFIX pp: <http://purl.org/net/p-plan#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
CONSTRUCT {
  ?from pm:hasOutgoingTransition ?transition; rdfs:label ?fromLabel.
  ?transition a ?kind; pm:transitionTo ?to; rdfs:label ?transitionLabel;
              pm:hasCondition ?condition.
  ?to rdfs:label ?toLabel.
  ?condition rdfs:label ?conditionLabel; pm:expectedOutcome ?outcome.
  ?outcome rdfs:label ?outcomeLabel.
  ?choice a pm:ExclusiveChoice; rdfs:label ?choiceLabel; pm:hasAlternative ?transition.
} WHERE {
  ?transition pm:transitionFrom ?from; pm:transitionTo ?to;
              rdfs:label ?transitionLabel; a ?kind.
  pm:Method_Omega (^pp:isStepOfPlan/pp:isDecomposedAsPlan)* ?plan.
  ?from pp:isStepOfPlan ?plan.
  FILTER(?kind IN (pm:Finish_To_Start_Transition, pm:ConditionalTransition))
  ?from rdfs:label ?fromLabel.
  ?to rdfs:label ?toLabel.
  # To show only the expanded Requirements Acquisition flow, uncomment:
  # ?from pp:isStepOfPlan pm:Requirements_Acquisition_Plan.
  OPTIONAL {
    ?transition pm:hasCondition ?condition.
    ?condition rdfs:label ?conditionLabel; pm:expectedOutcome ?outcome.
    ?outcome rdfs:label ?outcomeLabel.
  }
  OPTIONAL { ?choice pm:hasAlternative ?transition; rdfs:label ?choiceLabel. }
}
