PREFIX pm: <https://in2use.com/process_model/>
PREFIX pp: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX sulo: <https://w3id.org/sulo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?voteActivity ?decision ?outcome ?transition ?nextStep ?performedActivity WHERE {
  pm:Tender_Run_01 sulo:hasPart ?voteActivity, ?performedActivity.
  ?decision a pm:Decision_Result; prov:wasGeneratedBy ?voteActivity;
    pp:correspondsToVariable ?variable; pm:has_outcome ?outcome.
  pm:Submission_Choice pm:has_alternative ?transition.
  ?transition pm:has_condition ?condition; pm:has_target_step ?nextStep.
  ?condition pm:has_condition_variable ?variable; pm:has_expected_outcome ?outcome.
  ?performedActivity pp:correspondsToStep ?nextStep.
}
