PREFIX pm: <https://in2use.com/process_model/>
PREFIX pp: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX sulo: <https://w3id.org/sulo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?voteActivity ?decision ?outcome ?transition ?nextStep ?performedActivity WHERE {
  pm:TenderRun01 sulo:hasPart ?voteActivity, ?performedActivity.
  ?decision a pm:DecisionResult; prov:wasGeneratedBy ?voteActivity;
    pp:correspondsToVariable ?variable; pm:hasOutcome ?outcome.
  pm:SubmissionChoice pm:hasAlternative ?transition.
  ?transition pm:hasCondition ?condition; pm:transitionTo ?nextStep.
  ?condition pm:conditionVariable ?variable; pm:expectedOutcome ?outcome.
  ?performedActivity pp:correspondsToStep ?nextStep.
}
